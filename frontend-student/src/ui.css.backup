/* ================================
   EEC STUDENT PORTAL - UI UPGRADE
   UI ONLY - NO FUNCTIONAL CHANGES
================================ */

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  background: #f6f8fc;
  color: #172033;
}

/* Navbar */

nav {
  background: rgba(255,255,255,.94) !important;
  border-bottom: 1px solid #e8ecf3 !important;
  box-shadow: 0 2px 12px rgba(15,23,42,.04) !important;
  backdrop-filter: blur(14px);
}

nav a {
  transition: all .2s ease !important;
}

nav a:hover {
  color: #2563eb !important;
}

/* Main page */

main {
  min-height: calc(100vh - 70px);
}

.max-w-6xl,
.max-w-5xl {
  position: relative;
}

/* Cards */

.bg-white {
  border-color: #e7ebf2 !important;
}

.rounded-2xl {
  border-radius: 18px !important;
}

.shadow-sm {
  box-shadow: 0 8px 30px rgba(15,23,42,.055) !important;
}

/* Buttons */

button,
a {
  transition: all .2s ease;
}

button:hover,
.bg-blue-600:hover {
  transform: translateY(-1px);
}

/* Inputs */

input,
select,
textarea {
  border-color: #dfe4ec !important;
  background: #fff !important;
  transition: border-color .2s ease, box-shadow .2s ease;
}

input:focus,
select:focus,
textarea:focus {
  border-color: #3b82f6 !important;
  box-shadow: 0 0 0 3px rgba(59,130,246,.12) !important;
  outline: none !important;
}

/* Dashboard cards */

.grid > div {
  transition: transform .2s ease, box-shadow .2s ease;
}

.grid > div:hover {
  transform: translateY(-2px);
}

/* Status */

.bg-green-100 {
  background: #ecfdf3 !important;
}

.text-green-700 {
  color: #15803d !important;
}

/* Login page */

.min-h-screen {
  background:
    radial-gradient(circle at 15% 20%, rgba(59,130,246,.10), transparent 28%),
    radial-gradient(circle at 85% 80%, rgba(99,102,241,.08), transparent 30%),
    #f7f9fc !important;
}

/* File upload */

.border-dashed {
  border-color: #cfd7e6 !important;
  background: #fafcff;
  transition: all .2s ease;
}

.border-dashed:hover {
  border-color: #60a5fa !important;
  background: #f5f9ff;
}

/* Headings */

h1 {
  letter-spacing: -.025em;
}

h2,
h3 {
  letter-spacing: -.015em;
}

/* Mobile */

@media (max-width: 768px) {
  nav {
    position: relative !important;
  }

  .p-6 {
    padding: 1rem !important;
  }

  h1 {
    font-size: 1.7rem !important;
  }
}
