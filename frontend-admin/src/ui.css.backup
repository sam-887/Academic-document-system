/* ================================
   EEC ADMIN PORTAL - UI UPGRADE
   UI ONLY - NO FUNCTIONAL CHANGES
================================ */

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  background: #f5f7fb;
  color: #172033;
}

/* Navbar */

nav {
  background: rgba(255,255,255,.95) !important;
  border-bottom: 1px solid #e5e9f0 !important;
  box-shadow: 0 2px 14px rgba(15,23,42,.05) !important;
  backdrop-filter: blur(14px);
}

nav a {
  transition: all .2s ease !important;
}

nav a:hover {
  color: #2563eb !important;
}

/* Main */

main {
  min-height: calc(100vh - 70px);
}

/* Cards */

.bg-white {
  border-color: #e4e8f0 !important;
}

.rounded-2xl {
  border-radius: 18px !important;
}

.shadow-sm {
  box-shadow: 0 8px 28px rgba(15,23,42,.055) !important;
}

/* Tables */

table {
  border-collapse: separate !important;
  border-spacing: 0;
}

thead {
  background: #f8fafc !important;
}

th {
  color: #64748b !important;
  font-size: .78rem;
  text-transform: uppercase;
  letter-spacing: .04em;
}

tbody tr {
  transition: background .15s ease;
}

tbody tr:hover {
  background: #f8fbff !important;
}

/* Buttons */

button,
a {
  transition: all .2s ease;
}

button:hover {
  transform: translateY(-1px);
}

/* Inputs */

input,
select,
textarea {
  border-color: #dce2eb !important;
  background: #fff !important;
  transition: border-color .2s ease, box-shadow .2s ease;
}

input:focus,
select:focus,
textarea:focus {
  border-color: #3b82f6 !important;
  box-shadow: 0 0 0 3px rgba(59,130,246,.12) !important;
  outline: none !important;
}

/* Dashboard */

.grid > div {
  transition: transform .2s ease, box-shadow .2s ease;
}

.grid > div:hover {
  transform: translateY(-2px);
}

/* Login */

.min-h-screen {
  background:
    radial-gradient(circle at 12% 18%, rgba(59,130,246,.09), transparent 28%),
    radial-gradient(circle at 88% 82%, rgba(99,102,241,.08), transparent 30%),
    #f7f9fc !important;
}

/* Headings */

h1 {
  letter-spacing: -.025em;
}

h2,
h3 {
  letter-spacing: -.015em;
}

/* Mobile */

@media (max-width: 768px) {
  .p-6 {
    padding: 1rem !important;
  }

  h1 {
    font-size: 1.7rem !important;
  }
}
