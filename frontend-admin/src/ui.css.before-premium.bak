body.eec-dark-mode .eec-final-admin-profile-text small,
body.eec-dark-mode .eec-final-admin-menu-user small,
body.eec-dark-mode .eec-final-admin-setting small {
  color: #5ab8cc;
}

body.eec-dark-mode .eec-final-admin-menu {
  background: rgba(1,15,24,.97);
  border-color: #0d3347;
  box-shadow: 0 20px 55px rgba(0,0,0,.42);
}

body.eec-dark-mode .eec-final-admin-menu-divider {
  background: #0d3347;
}

body.eec-dark-mode .eec-final-admin-setting {
  background: rgba(0,212,255,.045);
}

body.eec-dark-mode .eec-final-admin-setting-icon {
  color: #00d4ff;
  background: rgba(0,212,255,.08);
}

body.eec-dark-mode .eec-final-admin-logout:hover {
  background: rgba(255,51,85,.09);
}

@media (max-width: 950px) {
  .eec-final-admin-nav-inner {
    padding: 0 14px;
    gap: 10px;
  }

  .eec-final-admin-brand-copy small,
  .eec-final-admin-link span,
  .eec-final-admin-profile-text {
    display: none;
  }

  .eec-final-admin-brand {
    margin-right: auto;
  }

  .eec-final-admin-links {
    flex: 0 0 auto;
  }
}
