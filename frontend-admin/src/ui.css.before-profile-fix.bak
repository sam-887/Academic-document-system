body.eec-dark-mode .eec-final-admin-profile-text small,
body.eec-dark-mode .eec-final-admin-menu-user small,
body.eec-dark-mode .eec-final-admin-setting small {
  color: #5ab8cc;
}

body.eec-dark-mode .eec-final-admin-menu {
  background: rgba(1,15,24,.97);
  border-color: #0d3347;
  box-shadow: 0 20px 55px rgba(0,0,0,.42);
}

body.eec-dark-mode .eec-final-admin-menu-divider {
  background: #0d3347;
}

body.eec-dark-mode .eec-final-admin-setting {
  background: rgba(0,212,255,.045);
}

body.eec-dark-mode .eec-final-admin-setting-icon {
  color: #00d4ff;
  background: rgba(0,212,255,.08);
}

body.eec-dark-mode .eec-final-admin-logout:hover {
  background: rgba(255,51,85,.09);
}

@media (max-width: 950px) {
  .eec-final-admin-nav-inner {
    padding: 0 14px;
    gap: 10px;
  }

  .eec-final-admin-brand-copy small,
  .eec-final-admin-link span,
  .eec-final-admin-profile-text {
    display: none;
  }

  .eec-final-admin-brand {
    margin-right: auto;
  }

  .eec-final-admin-links {
    flex: 0 0 auto;
  }
}

/* =========================================================
   EEC PREMIUM UI — DARK GRAPHITE / NEON SYSTEM
   UI ONLY — routes, APIs and functionality untouched
   ========================================================= */

:root {
  --eec-bg: #080b12;
  --eec-bg-2: #0d111c;
  --eec-surface: #111722;
  --eec-surface-2: #171e2b;
  --eec-surface-3: #1c2534;
  --eec-border: rgba(255,255,255,.075);
  --eec-border-strong: rgba(255,255,255,.13);

  --eec-text: #f5f7fb;
  --eec-text-2: #c5ccda;
  --eec-muted: #8993a6;

  --eec-blue: #4f8cff;
  --eec-blue-2: #6b5cff;
  --eec-purple: #9b5cff;
  --eec-pink: #ff3d9a;
  --eec-orange: #ff7a18;

  --eec-green: #21e6a1;
  --eec-gold: #ffc94a;
  --eec-red: #ff4d67;

  --eec-radius: 20px;
  --eec-shadow:
    0 18px 55px rgba(0,0,0,.28),
    inset 0 1px 0 rgba(255,255,255,.025);

  --eec-glow-blue: 0 0 28px rgba(79,140,255,.16);
  --eec-glow-pink: 0 0 28px rgba(255,61,154,.15);
}

/* =========================================================
   GLOBAL DARK MODE
   ========================================================= */

body.eec-dark-mode {
  background:
    radial-gradient(
      circle at 15% 5%,
      rgba(79,140,255,.11),
      transparent 28%
    ),
    radial-gradient(
      circle at 85% 15%,
      rgba(155,92,255,.08),
      transparent 25%
    ),
    linear-gradient(
      135deg,
      var(--eec-bg),
      var(--eec-bg-2)
    ) !important;

  color: var(--eec-text) !important;
}

body.eec-dark-mode,
body.eec-dark-mode #root {
  min-height: 100vh;
}

body.eec-dark-mode main,
body.eec-dark-mode .page,
body.eec-dark-mode .container {
  color: var(--eec-text);
}

/* =========================================================
   NAVBAR
   ========================================================= */

body.eec-dark-mode nav {
  background:
    linear-gradient(
      180deg,
      rgba(20,27,40,.96),
      rgba(11,15,24,.96)
    ) !important;

  border-color: var(--eec-border) !important;

  box-shadow:
    0 12px 40px rgba(0,0,0,.22),
    inset 0 -1px 0 rgba(255,255,255,.025);

  backdrop-filter: blur(20px);
}

body.eec-dark-mode nav a {
  color: var(--eec-text-2) !important;
}

body.eec-dark-mode nav a:hover {
  color: #fff !important;
}

body.eec-dark-mode nav a.active,
body.eec-dark-mode nav a[aria-current="page"] {
  color: #fff !important;

  background:
    linear-gradient(
      135deg,
      rgba(79,140,255,.22),
      rgba(107,92,255,.18)
    ) !important;

  border: 1px solid rgba(79,140,255,.25);

  box-shadow:
    0 8px 25px rgba(79,140,255,.12),
    inset 0 1px 0 rgba(255,255,255,.06);
}

/* =========================================================
   GENERAL SURFACES
   ========================================================= */

body.eec-dark-mode .bg-white {
  background:
    linear-gradient(
      145deg,
      rgba(25,32,45,.98),
      rgba(15,21,31,.98)
    ) !important;

  color: var(--eec-text) !important;
}

body.eec-dark-mode .bg-slate-50,
body.eec-dark-mode .bg-gray-50,
body.eec-dark-mode .bg-gray-100,
body.eec-dark-mode .bg-slate-100 {
  background: var(--eec-surface) !important;
}

body.eec-dark-mode .bg-slate-900,
body.eec-dark-mode .bg-gray-900 {
  background: #080b12 !important;
}

body.eec-dark-mode .border,
body.eec-dark-mode .border-gray-100,
body.eec-dark-mode .border-gray-200,
body.eec-dark-mode .border-slate-100,
body.eec-dark-mode .border-slate-200 {
  border-color: var(--eec-border) !important;
}

/* =========================================================
   TEXT
   ========================================================= */

body.eec-dark-mode .text-gray-900,
body.eec-dark-mode .text-gray-800,
body.eec-dark-mode .text-slate-900,
body.eec-dark-mode .text-slate-800 {
  color: var(--eec-text) !important;
}

body.eec-dark-mode .text-gray-700,
body.eec-dark-mode .text-slate-700 {
  color: var(--eec-text-2) !important;
}

body.eec-dark-mode .text-gray-600,
body.eec-dark-mode .text-gray-500,
body.eec-dark-mode .text-slate-600,
body.eec-dark-mode .text-slate-500 {
  color: var(--eec-muted) !important;
}

/* =========================================================
   CARDS
   ========================================================= */

body.eec-dark-mode .rounded-xl,
body.eec-dark-mode .rounded-2xl,
body.eec-dark-mode .rounded-3xl,
body.eec-dark-mode .document-card {
  border-radius: var(--eec-radius) !important;
}

body.eec-dark-mode .shadow,
body.eec-dark-mode .shadow-sm,
body.eec-dark-mode .shadow-md,
body.eec-dark-mode .shadow-lg,
body.eec-dark-mode .shadow-xl {
  box-shadow: var(--eec-shadow) !important;
}

body.eec-dark-mode .bg-white.border,
body.eec-dark-mode .document-card {
  background:
    linear-gradient(
      145deg,
      rgba(25,32,45,.98),
      rgba(14,19,29,.98)
    ) !important;

  border: 1px solid var(--eec-border) !important;

  box-shadow: var(--eec-shadow) !important;

  transition:
    transform .2s ease,
    border-color .2s ease,
    box-shadow .2s ease;
}

body.eec-dark-mode .bg-white.border:hover,
body.eec-dark-mode .document-card:hover {
  transform: translateY(-2px);

  border-color:
    rgba(79,140,255,.22) !important;

  box-shadow:
    0 22px 65px rgba(0,0,0,.34),
    0 0 28px rgba(79,140,255,.06) !important;
}

/* =========================================================
   INPUTS / SELECTS / TEXTAREAS
   ========================================================= */

body.eec-dark-mode input,
body.eec-dark-mode select,
body.eec-dark-mode textarea {
  background:
    rgba(9,13,21,.9) !important;

  color: var(--eec-text) !important;

  border:
    1px solid var(--eec-border-strong) !important;

  box-shadow:
    inset 0 1px 2px rgba(0,0,0,.22);
}

body.eec-dark-mode input::placeholder,
body.eec-dark-mode textarea::placeholder {
  color: #687386 !important;
}

body.eec-dark-mode input:focus,
body.eec-dark-mode select:focus,
body.eec-dark-mode textarea:focus {
  border-color:
    rgba(79,140,255,.7) !important;

  box-shadow:
    0 0 0 4px rgba(79,140,255,.10),
    0 0 25px rgba(79,140,255,.08) !important;
}

/* =========================================================
   TABLES / REQUEST LISTS
   ========================================================= */

body.eec-dark-mode table {
  color: var(--eec-text) !important;
}

body.eec-dark-mode thead {
  background:
    rgba(255,255,255,.035) !important;
}

body.eec-dark-mode th {
  color: #9da8ba !important;
}

body.eec-dark-mode td {
  color: var(--eec-text-2) !important;
  border-color: var(--eec-border) !important;
}

body.eec-dark-mode tbody tr {
  background: transparent !important;
}

body.eec-dark-mode tbody tr:hover {
  background:
    rgba(79,140,255,.045) !important;
}

/* =========================================================
   STATUS COLORS — ONLY STATUS BADGES
   ========================================================= */

body.eec-dark-mode
[class*="bg-green-100"],
body.eec-dark-mode
[class*="bg-emerald-100"] {
  background:
    rgba(33,230,161,.16) !important;

  color:
    #21e6a1 !important;

  border:
    1px solid rgba(33,230,161,.28) !important;

  box-shadow:
    0 0 18px rgba(33,230,161,.10);
}

body.eec-dark-mode
[class*="bg-amber-100"],
body.eec-dark-mode
[class*="bg-yellow-100"] {
  background:
    rgba(255,201,74,.16) !important;

  color:
    #ffc94a !important;

  border:
    1px solid rgba(255,201,74,.28) !important;

  box-shadow:
    0 0 18px rgba(255,201,74,.09);
}

body.eec-dark-mode
[class*="bg-red-100"],
body.eec-dark-mode
[class*="bg-rose-100"] {
  background:
    rgba(255,77,103,.15) !important;

  color:
    #ff5b73 !important;

  border:
    1px solid rgba(255,77,103,.28) !important;

  box-shadow:
    0 0 18px rgba(255,77,103,.09);
}

/* =========================================================
   BLUE / PRIMARY
   ========================================================= */

body.eec-dark-mode .bg-blue-600,
body.eec-dark-mode .bg-blue-500 {
  background:
    linear-gradient(
      135deg,
      #3d7cff,
      #6b5cff
    ) !important;

  color: white !important;

  box-shadow:
    0 8px 25px rgba(79,140,255,.22);
}

body.eec-dark-mode .bg-blue-600:hover,
body.eec-dark-mode .bg-blue-500:hover {
  filter: brightness(1.08);
  box-shadow:
    0 10px 30px rgba(79,140,255,.30);
}

/* =========================================================
   BUTTONS
   ========================================================= */

body.eec-dark-mode button {
  color: inherit;
}

body.eec-dark-mode button:hover {
  transform: translateY(-1px);
}

body.eec-dark-mode button:active {
  transform: translateY(0);
}

/* =========================================================
   FILE UPLOAD / DROP ZONES
   ========================================================= */

body.eec-dark-mode
input[type="file"] {
  background:
    linear-gradient(
      145deg,
      #151c29,
      #0e141e
    ) !important;

  color: var(--eec-text-2) !important;

  border:
    1px dashed rgba(255,255,255,.15) !important;
}

body.eec-dark-mode
[class*="border-dashed"] {
  background:
    rgba(255,255,255,.018) !important;

  border-color:
    rgba(255,255,255,.12) !important;
}

body.eec-dark-mode
[class*="border-dashed"]:hover {
  background:
    rgba(79,140,255,.045) !important;

  border-color:
    rgba(79,140,255,.38) !important;
}

/* =========================================================
   CHAT / MESSAGE BUBBLES
   ========================================================= */

body.eec-dark-mode .message-bubble {
  background:
    var(--eec-surface-2) !important;

  color:
    var(--eec-text) !important;

  border:
    1px solid var(--eec-border) !important;
}

/* =========================================================
   TIMELINES
   ========================================================= */

body.eec-dark-mode .request-timeline::before {
  background:
    rgba(255,255,255,.10) !important;
}

/* =========================================================
   MODALS / DROPDOWNS
   ========================================================= */

body.eec-dark-mode [role="dialog"],
body.eec-dark-mode [role="menu"] {
  background:
    linear-gradient(
      145deg,
      #1a2230,
      #101620
    ) !important;

  color:
    var(--eec-text) !important;

  border:
    1px solid var(--eec-border-strong) !important;

  box-shadow:
    0 25px 80px rgba(0,0,0,.45) !important;
}

/* =========================================================
   PROFILE / SETTINGS PANELS
   ========================================================= */

body.eec-dark-mode
[class*="settings"],
body.eec-dark-mode
[class*="profile-menu"],
body.eec-dark-mode
[class*="dropdown"] {
  color: var(--eec-text);
}

/* =========================================================
   SCROLLBAR
   ========================================================= */

body.eec-dark-mode ::-webkit-scrollbar-track {
  background: #080b12;
}

body.eec-dark-mode ::-webkit-scrollbar-thumb {
  background:
    #30394a;
}

body.eec-dark-mode ::-webkit-scrollbar-thumb:hover {
  background:
    #47536a;
}

/* =========================================================
   LIGHT MODE — PRESERVE EXISTING DESIGN
   ========================================================= */

body:not(.eec-dark-mode) {
  color-scheme: light;
}

body.eec-dark-mode {
  color-scheme: dark;
}

/* =========================================================
   SMOOTH THEME TRANSITION
   ========================================================= */

body,
body * {
  transition:
    background-color .18s ease,
    border-color .18s ease,
    color .18s ease;
}

@media (prefers-reduced-motion: reduce) {
  body,
  body * {
    transition: none !important;
  }
}

/* ============================================================
   EEC FINAL LIGHT THEME
   Dark mode is intentionally excluded.
   ============================================================ */

body:not(.eec-dark-mode) {
  --light-bg: #f6f8fc;
  --light-surface: #ffffff;
  --light-surface-soft: #f8fafc;
  --light-border: #e2e8f0;
  --light-border-strong: #cbd5e1;
  --light-text: #0f172a;
  --light-text-2: #334155;
  --light-muted: #64748b;
  --light-primary: #2563eb;
  --light-primary-soft: #eff6ff;

  background:
    radial-gradient(
      circle at 0% 0%,
      rgba(37,99,235,.045),
      transparent 30%
    ),
    var(--light-bg) !important;

  color: var(--light-text) !important;
}

/* ---------- PAGE ---------- */

body:not(.eec-dark-mode) main,
body:not(.eec-dark-mode) .page,
body:not(.eec-dark-mode) .container {
  color: var(--light-text);
}

/* ---------- HEADERS ---------- */

body:not(.eec-dark-mode) h1,
body:not(.eec-dark-mode) h2,
body:not(.eec-dark-mode) h3,
body:not(.eec-dark-mode) h4,
body:not(.eec-dark-mode) h5,
body:not(.eec-dark-mode) h6 {
  color: var(--light-text) !important;
}

body:not(.eec-dark-mode) p {
  color: var(--light-text-2);
}

/* ---------- NAVIGATION ---------- */

body:not(.eec-dark-mode) nav {
  background: rgba(255,255,255,.96) !important;
  color: var(--light-text) !important;
  border-color: var(--light-border) !important;
}

body:not(.eec-dark-mode) nav a {
  color: var(--light-muted) !important;
}

body:not(.eec-dark-mode) nav a:hover {
  color: var(--light-text) !important;
  background: #f8fafc !important;
}

body:not(.eec-dark-mode) nav a.active,
body:not(.eec-dark-mode) nav a[aria-current="page"] {
  color: var(--light-primary) !important;
  background: var(--light-primary-soft) !important;
  border-color: #dbeafe !important;
}

/* Navigation SVG icons only */
body:not(.eec-dark-mode) nav a svg {
  color: currentColor !important;
  stroke: currentColor !important;
}

/* ---------- CARDS ---------- */

body:not(.eec-dark-mode) .bg-white,
body:not(.eec-dark-mode) .document-card {
  background: var(--light-surface) !important;
  color: var(--light-text) !important;
}

body:not(.eec-dark-mode) .bg-white.border,
body:not(.eec-dark-mode) .document-card {
  border-color: var(--light-border) !important;
  box-shadow: 0 8px 30px rgba(15,23,42,.06) !important;
}

body:not(.eec-dark-mode) .bg-white.border:hover,
body:not(.eec-dark-mode) .document-card:hover {
  border-color: #d5dce7 !important;
  box-shadow: 0 14px 38px rgba(15,23,42,.10) !important;
}

/* ---------- COMMON LIGHT SURFACES ---------- */

body:not(.eec-dark-mode) .bg-slate-50,
body:not(.eec-dark-mode) .bg-gray-50 {
  background: var(--light-surface-soft) !important;
}

body:not(.eec-dark-mode) .bg-slate-100,
body:not(.eec-dark-mode) .bg-gray-100 {
  background: #f1f5f9 !important;
}

/* ---------- TEXT COLORS ---------- */

body:not(.eec-dark-mode) .text-slate-900,
body:not(.eec-dark-mode) .text-slate-800,
body:not(.eec-dark-mode) .text-gray-900,
body:not(.eec-dark-mode) .text-gray-800 {
  color: var(--light-text) !important;
}

body:not(.eec-dark-mode) .text-slate-700,
body:not(.eec-dark-mode) .text-gray-700 {
  color: var(--light-text-2) !important;
}

body:not(.eec-dark-mode) .text-slate-600,
body:not(.eec-dark-mode) .text-gray-600,
body:not(.eec-dark-mode) .text-slate-500,
body:not(.eec-dark-mode) .text-gray-500 {
  color: var(--light-muted) !important;
}

/* Fix accidental pale text on normal surfaces.
   Do NOT globally override text-white because buttons may need it. */

body:not(.eec-dark-mode) .bg-white .text-white,
body:not(.eec-dark-mode) .bg-slate-50 .text-white,
body:not(.eec-dark-mode) .bg-gray-50 .text-white {
  color: var(--light-text) !important;
}

/* ---------- BORDERS ---------- */

body:not(.eec-dark-mode) .border,
body:not(.eec-dark-mode) .border-gray-100,
body:not(.eec-dark-mode) .border-gray-200,
body:not(.eec-dark-mode) .border-slate-100,
body:not(.eec-dark-mode) .border-slate-200 {
  border-color: var(--light-border) !important;
}

/* ---------- INPUTS ---------- */

body:not(.eec-dark-mode) input,
body:not(.eec-dark-mode) select,
body:not(.eec-dark-mode) textarea {
  background: #ffffff !important;
  color: var(--light-text) !important;
  border-color: var(--light-border-strong) !important;
}

body:not(.eec-dark-mode) input::placeholder,
body:not(.eec-dark-mode) textarea::placeholder {
  color: #94a3b8 !important;
}

body:not(.eec-dark-mode) input:focus,
body:not(.eec-dark-mode) select:focus,
body:not(.eec-dark-mode) textarea:focus {
  border-color: rgba(37,99,235,.65) !important;
  box-shadow: 0 0 0 4px rgba(37,99,235,.10) !important;
}

/* File upload */
body:not(.eec-dark-mode) input[type="file"] {
  background: #ffffff !important;
  color: var(--light-text-2) !important;
  border-color: var(--light-border-strong) !important;
}

/* ---------- TABLES ---------- */

body:not(.eec-dark-mode) table {
  color: var(--light-text);
}

body:not(.eec-dark-mode) thead {
  background: #f8fafc !important;
}

body:not(.eec-dark-mode) th {
  color: #475569 !important;
}

body:not(.eec-dark-mode) td {
  color: var(--light-text-2) !important;
  border-color: var(--light-border) !important;
}

body:not(.eec-dark-mode) tbody tr:hover {
  background: #f8fafc !important;
}

/* ---------- MESSAGE UI ---------- */

body:not(.eec-dark-mode) .message-bubble {
  background: #ffffff !important;
  color: var(--light-text-2) !important;
  border: 1px solid var(--light-border) !important;
  box-shadow: 0 2px 8px rgba(15,23,42,.04) !important;
}

body:not(.eec-dark-mode) .message-bubble svg {
  color: currentColor !important;
  stroke: currentColor !important;
}

/* ---------- NOTIFICATIONS ---------- */

body:not(.eec-dark-mode) [class*="notification"] {
  color: var(--light-text);
}

body:not(.eec-dark-mode) [class*="notification"] svg {
  color: currentColor !important;
  stroke: currentColor !important;
}

/* ---------- REQUESTS ---------- */

body:not(.eec-dark-mode) [class*="request"] {
  color: var(--light-text-2);
}

body:not(.eec-dark-mode) .request-timeline::before {
  background: #cbd5e1 !important;
}

/* ---------- ICONS ON NORMAL SURFACES ---------- */

body:not(.eec-dark-mode) .bg-white svg,
body:not(.eec-dark-mode) .bg-slate-50 svg,
body:not(.eec-dark-mode) .bg-gray-50 svg {
  color: #475569;
}

body:not(.eec-dark-mode) .bg-white svg[stroke],
body:not(.eec-dark-mode) .bg-slate-50 svg[stroke],
body:not(.eec-dark-mode) .bg-gray-50 svg[stroke] {
  stroke: currentColor !important;
}

/* ---------- FILTERS ---------- */

body:not(.eec-dark-mode) .ui-filter-label {
  color: var(--light-muted) !important;
}

body:not(.eec-dark-mode) .ui-filter-bar select {
  background: #ffffff !important;
  color: var(--light-text) !important;
  border-color: var(--light-border-strong) !important;
}

/* ---------- DASHBOARD STAT CARDS ---------- */

body:not(.eec-dark-mode) .grid > div[class*="border"],
body:not(.eec-dark-mode) .grid > a[class*="border"] {
  background: #ffffff !important;
  color: var(--light-text) !important;
  border-color: var(--light-border) !important;
}

/* ---------- STATUS BADGES ---------- */

body:not(.eec-dark-mode) .bg-green-100,
body:not(.eec-dark-mode) .bg-emerald-100 {
  background: #dcfce7 !important;
  color: #166534 !important;
  border-color: #bbf7d0 !important;
}

body:not(.eec-dark-mode) .bg-amber-100,
body:not(.eec-dark-mode) .bg-yellow-100 {
  background: #fef3c7 !important;
  color: #92400e !important;
  border-color: #fde68a !important;
}

body:not(.eec-dark-mode) .bg-red-100,
body:not(.eec-dark-mode) .bg-rose-100 {
  background: #fee2e2 !important;
  color: #991b1b !important;
  border-color: #fecaca !important;
}

/* ---------- MODALS / DROPDOWNS ---------- */

body:not(.eec-dark-mode) [role="dialog"],
body:not(.eec-dark-mode) [role="menu"] {
  background: #ffffff !important;
  color: var(--light-text) !important;
  border-color: var(--light-border) !important;
  box-shadow: 0 20px 60px rgba(15,23,42,.14) !important;
}

/* ---------- DROPDOWN TEXT ---------- */

body:not(.eec-dark-mode) [role="menu"] strong,
body:not(.eec-dark-mode) [role="menu"] span,
body:not(.eec-dark-mode) [role="dialog"] strong,
body:not(.eec-dark-mode) [role="dialog"] span {
  color: inherit;
}

/* ---------- LINKS ---------- */

body:not(.eec-dark-mode) main a {
  color: var(--light-primary);
}

body:not(.eec-dark-mode) main a:hover {
  color: #1d4ed8;
}

/* ---------- SCROLLBAR ---------- */

body:not(.eec-dark-mode) ::-webkit-scrollbar-track {
  background: #f1f5f9;
}

body:not(.eec-dark-mode) ::-webkit-scrollbar-thumb {
  background: #cbd5e1;
}

body:not(.eec-dark-mode) ::-webkit-scrollbar-thumb:hover {
  background: #94a3b8;
}

/* ---------- NEVER AFFECT DARK MODE ---------- */

/* ============================================================
   ADMIN — FINAL LIGHT MODE COMPONENT FIX
   STUDENT PORTAL IS NOT TOUCHED.
   DARK MODE IS NOT TOUCHED.
   ============================================================ */

body:not(.eec-dark-mode) {

  /* ---------- GLOBAL ADMIN CONTENT ---------- */

  color: #0f172a !important;
}

body:not(.eec-dark-mode) main,
body:not(.eec-dark-mode) main > div,
body:not(.eec-dark-mode) section,
body:not(.eec-dark-mode) article {
  color: #0f172a;
}

/* ---------- ALL HEADERS ---------- */

body:not(.eec-dark-mode) main h1,
body:not(.eec-dark-mode) main h2,
body:not(.eec-dark-mode) main h3,
body:not(.eec-dark-mode) main h4,
body:not(.eec-dark-mode) main h5,
body:not(.eec-dark-mode) main h6 {
  color: #0f172a !important;
  opacity: 1 !important;
}

/* ---------- SUBHEADERS / DESCRIPTIONS ---------- */

body:not(.eec-dark-mode) main .text-gray-500,
body:not(.eec-dark-mode) main .text-gray-600,
body:not(.eec-dark-mode) main .text-slate-500,
body:not(.eec-dark-mode) main .text-slate-600 {
  color: #64748b !important;
  opacity: 1 !important;
}

/* ---------- ADMIN NAVBAR ---------- */

body:not(.eec-dark-mode) .admin-pro-navbar {
  background: #ffffff !important;
  color: #0f172a !important;
  border-color: #e2e8f0 !important;
}

body:not(.eec-dark-mode) .admin-pro-navbar * {
  opacity: 1;
}

body:not(.eec-dark-mode) .admin-pro-navbar a {
  color: #64748b !important;
}

body:not(.eec-dark-mode) .admin-pro-navbar a:hover {
  color: #0f172a !important;
  background: #f8fafc !important;
}

body:not(.eec-dark-mode) .admin-pro-navbar a.active {
  color: #2563eb !important;
  background: #eff6ff !important;
  border-color: #dbeafe !important;
}

body:not(.eec-dark-mode) .admin-pro-navbar svg {
  stroke: currentColor !important;
  color: currentColor !important;
}

/* ---------- NORMAL SVG ICONS ---------- */

body:not(.eec-dark-mode) main svg {
  opacity: 1 !important;
  color: #475569;
}

body:not(.eec-dark-mode) main svg[stroke],
body:not(.eec-dark-mode) main svg *[stroke] {
  stroke: currentColor !important;
}

/* Don't make filled icons disappear */
body:not(.eec-dark-mode) main svg[fill],
body:not(.eec-dark-mode) main svg *[fill] {
  fill: currentColor;
}

/* ---------- CARDS ---------- */

body:not(.eec-dark-mode) main .bg-white {
  background: #ffffff !important;
  color: #0f172a !important;
}

body:not(.eec-dark-mode) main .bg-white h1,
body:not(.eec-dark-mode) main .bg-white h2,
body:not(.eec-dark-mode) main .bg-white h3,
body:not(.eec-dark-mode) main .bg-white h4,
body:not(.eec-dark-mode) main .bg-white h5,
body:not(.eec-dark-mode) main .bg-white h6 {
  color: #0f172a !important;
}

body:not(.eec-dark-mode) main .bg-white p {
  color: #334155 !important;
}

/* ---------- CARD ICON CONTAINERS ---------- */

body:not(.eec-dark-mode) main .bg-blue-50 svg {
  color: #2563eb !important;
  stroke: currentColor !important;
}

body:not(.eec-dark-mode) main .bg-purple-50 svg {
  color: #7c3aed !important;
  stroke: currentColor !important;
}

body:not(.eec-dark-mode) main .bg-green-50 svg {
  color: #16a34a !important;
  stroke: currentColor !important;
}

body:not(.eec-dark-mode) main .bg-orange-50 svg {
  color: #ea580c !important;
  stroke: currentColor !important;
}

/* ---------- BUTTONS ---------- */

body:not(.eec-dark-mode) main button {
  opacity: 1 !important;
}

body:not(.eec-dark-mode) main button svg {
  color: currentColor !important;
  stroke: currentColor !important;
}

/* ---------- BLUE BUTTONS KEEP WHITE ---------- */

body:not(.eec-dark-mode) main .bg-blue-600,
body:not(.eec-dark-mode) main .bg-blue-500 {
  color: #ffffff !important;
}

body:not(.eec-dark-mode) main .bg-blue-600 *,
body:not(.eec-dark-mode) main .bg-blue-500 * {
  color: #ffffff !important;
}

body:not(.eec-dark-mode) main .bg-blue-600 svg,
body:not(.eec-dark-mode) main .bg-blue-500 svg {
  stroke: #ffffff !important;
}

/* ---------- INPUTS ---------- */

body:not(.eec-dark-mode) main input,
body:not(.eec-dark-mode) main select,
body:not(.eec-dark-mode) main textarea {
  background: #ffffff !important;
  color: #0f172a !important;
  border-color: #cbd5e1 !important;
  opacity: 1 !important;
}

body:not(.eec-dark-mode) main input::placeholder,
body:not(.eec-dark-mode) main textarea::placeholder {
  color: #94a3b8 !important;
}

body:not(.eec-dark-mode) main select option {
  background: #ffffff !important;
  color: #0f172a !important;
}

/* ---------- FORM LABELS ---------- */

body:not(.eec-dark-mode) main label {
  color: #334155 !important;
  opacity: 1 !important;
}

/* ---------- TABLE ---------- */

body:not(.eec-dark-mode) main table {
  background: #ffffff !important;
  color: #0f172a !important;
}

body:not(.eec-dark-mode) main thead {
  background: #f8fafc !important;
}

body:not(.eec-dark-mode) main th {
  color: #475569 !important;
  background: #f8fafc !important;
}

body:not(.eec-dark-mode) main td {
  color: #334155 !important;
  background: #ffffff !important;
}

body:not(.eec-dark-mode) main tr {
  border-color: #e2e8f0 !important;
}

body:not(.eec-dark-mode) main tbody tr:hover td {
  background: #f8fafc !important;
}

/* ---------- MESSAGE PAGE ---------- */

body:not(.eec-dark-mode) main [class*="message"] {
  color: #334155;
}

body:not(.eec-dark-mode) main [class*="message"] svg {
  color: #475569 !important;
  stroke: currentColor !important;
}

/* ---------- NOTIFICATION PAGE ---------- */

body:not(.eec-dark-mode) main [class*="notification"] {
  color: #334155;
}

body:not(.eec-dark-mode) main [class*="notification"] svg {
  color: #475569 !important;
  stroke: currentColor !important;
}

/* ---------- ANALYTICS ---------- */

body:not(.eec-dark-mode) main [class*="chart"],
body:not(.eec-dark-mode) main [class*="analytics"] {
  color: #0f172a;
}

body:not(.eec-dark-mode) main [class*="analytics"] svg {
  color: #475569 !important;
}

/* ---------- PROFILE / SETTINGS ---------- */

body:not(.eec-dark-mode) .admin-pro-settings,
body:not(.eec-dark-mode) .admin-pro-profile-menu,
body:not(.eec-dark-mode) .admin-pro-dropdown {
  background: #ffffff !important;
  color: #0f172a !important;
  border-color: #e2e8f0 !important;
}

body:not(.eec-dark-mode) .admin-pro-settings strong,
body:not(.eec-dark-mode) .admin-pro-profile-menu strong,
body:not(.eec-dark-mode) .admin-pro-dropdown strong {
  color: #0f172a !important;
}

body:not(.eec-dark-mode) .admin-pro-settings small,
body:not(.eec-dark-mode) .admin-pro-profile-menu small,
body:not(.eec-dark-mode) .admin-pro-dropdown small {
  color: #64748b !important;
}

/* ---------- DROPDOWN / MODAL ---------- */

body:not(.eec-dark-mode) [role="menu"],
body:not(.eec-dark-mode) [role="dialog"] {
  background: #ffffff !important;
  color: #0f172a !important;
  border-color: #e2e8f0 !important;
}

body:not(.eec-dark-mode) [role="menu"] svg,
body:not(.eec-dark-mode) [role="dialog"] svg {
  color: #475569 !important;
  stroke: currentColor !important;
}

/* ---------- STATUS BADGES ---------- */

body:not(.eec-dark-mode) .bg-green-100,
body:not(.eec-dark-mode) .bg-emerald-100 {
  background: #dcfce7 !important;
  color: #166534 !important;
  border-color: #bbf7d0 !important;
}

body:not(.eec-dark-mode) .bg-amber-100,
body:not(.eec-dark-mode) .bg-yellow-100 {
  background: #fef3c7 !important;
  color: #92400e !important;
  border-color: #fde68a !important;
}

body:not(.eec-dark-mode) .bg-red-100,
body:not(.eec-dark-mode) .bg-rose-100 {
  background: #fee2e2 !important;
  color: #991b1b !important;
  border-color: #fecaca !important;
}

/* ---------- UPLOAD AREAS ---------- */

body:not(.eec-dark-mode) main [class*="border-dashed"] {
  background: #ffffff !important;
  color: #334155 !important;
  border-color: #cbd5e1 !important;
}

body:not(.eec-dark-mode) main [class*="border-dashed"] svg {
  color: #64748b !important;
  stroke: currentColor !important;
}

/* ---------- CHECKBOXES ---------- */

body:not(.eec-dark-mode) input[type="checkbox"] {
  accent-color: #2563eb;
}

/* ---------- LINKS ---------- */

body:not(.eec-dark-mode) main a {
  opacity: 1 !important;
}

/* ---------- REMOVE FADED LIGHT-MODE CONTENT ---------- */

body:not(.eec-dark-mode) main .opacity-50,
body:not(.eec-dark-mode) main .opacity-60,
body:not(.eec-dark-mode) main .opacity-70 {
  opacity: 1 !important;
}

/* ============================================================
   END ADMIN LIGHT MODE FIX
   ============================================================ */

/* ============================================================
   ADMIN ANALYTICS — LIGHT MODE FINAL POLISH
   Dark mode completely untouched.
   ============================================================ */

body:not(.eec-dark-mode) main [class*="analytics"],
body:not(.eec-dark-mode) main [class*="Analytics"] {
  color: #0f172a !important;
}

/* Analytics cards */
body:not(.eec-dark-mode) main [class*="analytics"] .bg-white,
body:not(.eec-dark-mode) main [class*="Analytics"] .bg-white {
  background: #ffffff !important;
  color: #0f172a !important;
  border: 1px solid #e2e8f0 !important;
  box-shadow: 0 8px 24px rgba(15,23,42,.06) !important;
}

/* Card headings */
body:not(.eec-dark-mode) main [class*="analytics"] h1,
body:not(.eec-dark-mode) main [class*="analytics"] h2,
body:not(.eec-dark-mode) main [class*="analytics"] h3,
body:not(.eec-dark-mode) main [class*="analytics"] h4,
body:not(.eec-dark-mode) main [class*="Analytics"] h1,
body:not(.eec-dark-mode) main [class*="Analytics"] h2,
body:not(.eec-dark-mode) main [class*="Analytics"] h3,
body:not(.eec-dark-mode) main [class*="Analytics"] h4 {
  color: #0f172a !important;
}

/* Card descriptions / labels */
body:not(.eec-dark-mode) main [class*="analytics"] p,
body:not(.eec-dark-mode) main [class*="analytics"] span,
body:not(.eec-dark-mode) main [class*="Analytics"] p,
body:not(.eec-dark-mode) main [class*="Analytics"] span {
  color: #475569 !important;
}

/* Big analytics numbers */
body:not(.eec-dark-mode) main [class*="analytics"] .text-2xl,
body:not(.eec-dark-mode) main [class*="analytics"] .text-3xl,
body:not(.eec-dark-mode) main [class*="analytics"] .text-4xl,
body:not(.eec-dark-mode) main [class*="Analytics"] .text-2xl,
body:not(.eec-dark-mode) main [class*="Analytics"] .text-3xl,
body:not(.eec-dark-mode) main [class*="Analytics"] .text-4xl {
  color: #0f172a !important;
}

/* ---------- ICON CONTAINERS ---------- */

body:not(.eec-dark-mode) main [class*="analytics"] .bg-blue-50,
body:not(.eec-dark-mode) main [class*="Analytics"] .bg-blue-50 {
  background: #eff6ff !important;
  color: #2563eb !important;
}

body:not(.eec-dark-mode) main [class*="analytics"] .bg-green-50,
body:not(.eec-dark-mode) main [class*="Analytics"] .bg-green-50 {
  background: #f0fdf4 !important;
  color: #16a34a !important;
}

body:not(.eec-dark-mode) main [class*="analytics"] .bg-amber-50,
body:not(.eec-dark-mode) main [class*="Analytics"] .bg-amber-50 {
  background: #fffbeb !important;
  color: #d97706 !important;
}

body:not(.eec-dark-mode) main [class*="analytics"] .bg-red-50,
body:not(.eec-dark-mode) main [class*="Analytics"] .bg-red-50 {
  background: #fef2f2 !important;
  color: #dc2626 !important;
}

body:not(.eec-dark-mode) main [class*="analytics"] .bg-purple-50,
body:not(.eec-dark-mode) main [class*="Analytics"] .bg-purple-50 {
  background: #faf5ff !important;
  color: #7c3aed !important;
}

/* ---------- ANALYTICS SVG ICONS ---------- */

body:not(.eec-dark-mode) main [class*="analytics"] svg,
body:not(.eec-dark-mode) main [class*="Analytics"] svg {
  opacity: 1 !important;
  stroke: currentColor !important;
}

/* Prevent global SVG rules from making icons washed out */
body:not(.eec-dark-mode) main [class*="analytics"] .text-blue-600 svg,
body:not(.eec-dark-mode) main [class*="Analytics"] .text-blue-600 svg {
  color: #2563eb !important;
}

body:not(.eec-dark-mode) main [class*="analytics"] .text-green-600 svg,
body:not(.eec-dark-mode) main [class*="Analytics"] .text-green-600 svg {
  color: #16a34a !important;
}

body:not(.eec-dark-mode) main [class*="analytics"] .text-amber-600 svg,
body:not(.eec-dark-mode) main [class*="Analytics"] .text-amber-600 svg {
  color: #d97706 !important;
}

body:not(.eec-dark-mode) main [class*="analytics"] .text-red-600 svg,
body:not(.eec-dark-mode) main [class*="Analytics"] .text-red-600 svg {
  color: #dc2626 !important;
}

body:not(.eec-dark-mode) main [class*="analytics"] .text-purple-600 svg,
body:not(.eec-dark-mode) main [class*="Analytics"] .text-purple-600 svg {
  color: #7c3aed !important;
}

/* ---------- CHART / GRAPH AREA ---------- */

body:not(.eec-dark-mode) main [class*="analytics"] .recharts-wrapper,
body:not(.eec-dark-mode) main [class*="Analytics"] .recharts-wrapper {
  background: #ffffff !important;
}

body:not(.eec-dark-mode) main [class*="analytics"] .recharts-cartesian-axis-tick-value,
body:not(.eec-dark-mode) main [class*="Analytics"] .recharts-cartesian-axis-tick-value {
  fill: #64748b !important;
}

body:not(.eec-dark-mode) main [class*="analytics"] .recharts-cartesian-axis-line,
body:not(.eec-dark-mode) main [class*="Analytics"] .recharts-cartesian-axis-line {
  stroke: #cbd5e1 !important;
}

body:not(.eec-dark-mode) main [class*="analytics"] .recharts-cartesian-grid line,
body:not(.eec-dark-mode) main [class*="Analytics"] .recharts-cartesian-grid line {
  stroke: #e2e8f0 !important;
}

/* ---------- ANALYTICS DIVIDERS ---------- */

body:not(.eec-dark-mode) main [class*="analytics"] hr,
body:not(.eec-dark-mode) main [class*="Analytics"] hr {
  border-color: #e2e8f0 !important;
}

/* ---------- HOVER ---------- */

body:not(.eec-dark-mode) main [class*="analytics"] .bg-white:hover,
body:not(.eec-dark-mode) main [class*="Analytics"] .bg-white:hover {
  border-color: #cbd5e1 !important;
  box-shadow: 0 12px 32px rgba(15,23,42,.09) !important;
}

/* ============================================================
   END ANALYTICS LIGHT MODE
   ============================================================ */

/* ================================================================
   EEC ADMIN — FINAL LIGHT MODE COMPATIBILITY LAYER
   ================================================================
   IMPORTANT:
   - LIGHT MODE ONLY
   - DARK MODE COMPLETELY UNTOUCHED
   - BACKEND UNTOUCHED
   - ROUTES / FUNCTIONALITY UNTOUCHED
   ================================================================ */

body:not(.eec-dark-mode) {
  --eec-light-bg: #f6f8fc;
  --eec-light-card: #ffffff;
  --eec-light-soft: #f8fafc;
  --eec-light-border: #e2e8f0;
  --eec-light-border-2: #cbd5e1;
  --eec-light-heading: #0f172a;
  --eec-light-text: #334155;
  --eec-light-muted: #64748b;
  --eec-light-primary: #2563eb;
}

/* ================================================================
   1. PAGE BACKGROUND
   ================================================================ */

body:not(.eec-dark-mode),
body:not(.eec-dark-mode) #root {
  background: var(--eec-light-bg) !important;
  color: var(--eec-light-heading) !important;
}

body:not(.eec-dark-mode) main {
  background: transparent !important;
  color: var(--eec-light-heading) !important;
}

/* ================================================================
   2. ALL HEADINGS
   ================================================================ */

body:not(.eec-dark-mode) main h1,
body:not(.eec-dark-mode) main h2,
body:not(.eec-dark-mode) main h3,
body:not(.eec-dark-mode) main h4,
body:not(.eec-dark-mode) main h5,
body:not(.eec-dark-mode) main h6 {
  color: #0f172a !important;
  opacity: 1 !important;
}

/* Analytics title */
body:not(.eec-dark-mode) main h1.text-3xl,
body:not(.eec-dark-mode) main h1.text-2xl {
  color: #0f172a !important;
}

/* ================================================================
   3. NORMAL BODY TEXT
   ================================================================ */

body:not(.eec-dark-mode) main p:not(.text-white),
body:not(.eec-dark-mode) main li:not(.text-white) {
  color: #475569;
  opacity: 1 !important;
}

body:not(.eec-dark-mode) main .text-slate-900,
body:not(.eec-dark-mode) main .text-slate-800,
body:not(.eec-dark-mode) main .text-gray-900,
body:not(.eec-dark-mode) main .text-gray-800 {
  color: #0f172a !important;
}

body:not(.eec-dark-mode) main .text-slate-700,
body:not(.eec-dark-mode) main .text-gray-700 {
  color: #334155 !important;
}

body:not(.eec-dark-mode) main .text-slate-600,
body:not(.eec-dark-mode) main .text-gray-600 {
  color: #475569 !important;
}

body:not(.eec-dark-mode) main .text-slate-500,
body:not(.eec-dark-mode) main .text-gray-500 {
  color: #64748b !important;
}

/* ================================================================
   4. WHITE CARDS
   ================================================================ */

body:not(.eec-dark-mode) main .bg-white {
  background-color: #ffffff !important;
  color: #0f172a !important;
}

body:not(.eec-dark-mode) main .bg-white h1,
body:not(.eec-dark-mode) main .bg-white h2,
body:not(.eec-dark-mode) main .bg-white h3,
body:not(.eec-dark-mode) main .bg-white h4 {
  color: #0f172a !important;
}

body:not(.eec-dark-mode) main .bg-white p {
  color: #475569 !important;
}

/* Card borders */
body:not(.eec-dark-mode) main .bg-white.border,
body:not(.eec-dark-mode) main .bg-white[class*="border"] {
  border-color: #e2e8f0 !important;
  box-shadow: 0 6px 24px rgba(15,23,42,.055) !important;
}

/* ================================================================
   5. SOFT BACKGROUNDS
   ================================================================ */

body:not(.eec-dark-mode) main .bg-slate-50,
body:not(.eec-dark-mode) main .bg-gray-50 {
  background-color: #f8fafc !important;
}

body:not(.eec-dark-mode) main .bg-slate-100,
body:not(.eec-dark-mode) main .bg-gray-100 {
  background-color: #f1f5f9 !important;
}

/* ================================================================
   6. ANALYTICS METRIC CARDS
   ================================================================ */

/* Blue */
body:not(.eec-dark-mode) main .bg-blue-50 {
  background-color: #eff6ff !important;
}

/* Green */
body:not(.eec-dark-mode) main .bg-green-50 {
  background-color: #f0fdf4 !important;
}

/* Emerald */
body:not(.eec-dark-mode) main .bg-emerald-50 {
  background-color: #ecfdf5 !important;
}

/* Red */
body:not(.eec-dark-mode) main .bg-red-50 {
  background-color: #fef2f2 !important;
}

/* Rose */
body:not(.eec-dark-mode) main .bg-rose-50 {
  background-color: #fff1f2 !important;
}

/* Amber */
body:not(.eec-dark-mode) main .bg-amber-50 {
  background-color: #fffbeb !important;
}

/* Yellow */
body:not(.eec-dark-mode) main .bg-yellow-50 {
  background-color: #fefce8 !important;
}

/* Purple */
body:not(.eec-dark-mode) main .bg-purple-50 {
  background-color: #faf5ff !important;
}

/* Indigo */
body:not(.eec-dark-mode) main .bg-indigo-50 {
  background-color: #eef2ff !important;
}

/* ================================================================
   7. ANALYTICS NUMBERS
   ================================================================ */

body:not(.eec-dark-mode) main .text-4xl,
body:not(.eec-dark-mode) main .text-3xl,
body:not(.eec-dark-mode) main .text-2xl {
  opacity: 1 !important;
}

/* Preserve semantic metric colors */
body:not(.eec-dark-mode) main .text-blue-600 {
  color: #2563eb !important;
}

body:not(.eec-dark-mode) main .text-green-600 {
  color: #16a34a !important;
}

body:not(.eec-dark-mode) main .text-emerald-600 {
  color: #059669 !important;
}

body:not(.eec-dark-mode) main .text-red-600 {
  color: #dc2626 !important;
}

body:not(.eec-dark-mode) main .text-rose-600 {
  color: #e11d48 !important;
}

body:not(.eec-dark-mode) main .text-amber-600 {
  color: #d97706 !important;
}

body:not(.eec-dark-mode) main .text-yellow-600 {
  color: #ca8a04 !important;
}

body:not(.eec-dark-mode) main .text-purple-600 {
  color: #9333ea !important;
}

body:not(.eec-dark-mode) main .text-indigo-600 {
  color: #4f46e5 !important;
}

/* ================================================================
   8. ANALYTICS ICONS
   ================================================================ */

body:not(.eec-dark-mode) main .bg-blue-50 svg {
  color: #2563eb !important;
  stroke: currentColor !important;
}

body:not(.eec-dark-mode) main .bg-green-50 svg,
body:not(.eec-dark-mode) main .bg-emerald-50 svg {
  color: #16a34a !important;
  stroke: currentColor !important;
}

body:not(.eec-dark-mode) main .bg-red-50 svg,
body:not(.eec-dark-mode) main .bg-rose-50 svg {
  color: #dc2626 !important;
  stroke: currentColor !important;
}

body:not(.eec-dark-mode) main .bg-amber-50 svg,
body:not(.eec-dark-mode) main .bg-yellow-50 svg {
  color: #d97706 !important;
  stroke: currentColor !important;
}

body:not(.eec-dark-mode) main .bg-purple-50 svg {
  color: #9333ea !important;
  stroke: currentColor !important;
}

body:not(.eec-dark-mode) main .bg-indigo-50 svg {
  color: #4f46e5 !important;
  stroke: currentColor !important;
}

/* Never let icons become transparent/faded */
body:not(.eec-dark-mode) main svg {
  opacity: 1 !important;
}

/* ================================================================
   9. PROGRESS BARS
   ================================================================ */

body:not(.eec-dark-mode) main .bg-slate-200,
body:not(.eec-dark-mode) main .bg-gray-200 {
  background-color: #e2e8f0 !important;
}

/* ================================================================
   10. APPROVAL / REJECTION KPI PANELS
   ================================================================ */

body:not(.eec-dark-mode) main .text-green-500,
body:not(.eec-dark-mode) main .text-green-600,
body:not(.eec-dark-mode) main .text-green-700 {
  color: #16a34a !important;
}

body:not(.eec-dark-mode) main .text-red-500,
body:not(.eec-dark-mode) main .text-red-600,
body:not(.eec-dark-mode) main .text-red-700 {
  color: #dc2626 !important;
}

/* ================================================================
   11. DOCUMENT TYPE CARDS
   ================================================================ */

body:not(.eec-dark-mode) main [class*="rounded"] {
  opacity: 1;
}

body:not(.eec-dark-mode) main .border-slate-200,
body:not(.eec-dark-mode) main .border-gray-200 {
  border-color: #e2e8f0 !important;
}

/* ================================================================
   12. TABLES / REQUEST LISTS
   ================================================================ */

body:not(.eec-dark-mode) main table {
  background: #ffffff !important;
  color: #0f172a !important;
}

body:not(.eec-dark-mode) main thead {
  background: #f8fafc !important;
}

body:not(.eec-dark-mode) main th {
  color: #475569 !important;
  background: #f8fafc !important;
}

body:not(.eec-dark-mode) main td {
  color: #334155 !important;
  background: #ffffff !important;
  border-color: #e2e8f0 !important;
}

body:not(.eec-dark-mode) main tbody tr:hover td {
  background: #f8fafc !important;
}

/* ================================================================
   13. MESSAGES
   ================================================================ */

body:not(.eec-dark-mode) main .message-bubble,
body:not(.eec-dark-mode) main [class*="message"] {
  opacity: 1 !important;
}

body:not(.eec-dark-mode) main [class*="message"] svg {
  opacity: 1 !important;
}

/* ================================================================
   14. NOTIFICATIONS
   ================================================================ */

body:not(.eec-dark-mode) main [class*="notification"] {
  opacity: 1 !important;
}

body:not(.eec-dark-mode) main [class*="notification"] svg {
  opacity: 1 !important;
}

/* ================================================================
   15. FORMS
   ================================================================ */

body:not(.eec-dark-mode) main label {
  color: #334155 !important;
  opacity: 1 !important;
}

body:not(.eec-dark-mode) main input,
body:not(.eec-dark-mode) main select,
body:not(.eec-dark-mode) main textarea {
  background: #ffffff !important;
  color: #0f172a !important;
  border-color: #cbd5e1 !important;
}

body:not(.eec-dark-mode) main input::placeholder,
body:not(.eec-dark-mode) main textarea::placeholder {
  color: #94a3b8 !important;
}

body:not(.eec-dark-mode) main input:focus,
body:not(.eec-dark-mode) main select:focus,
body:not(.eec-dark-mode) main textarea:focus {
  border-color: #60a5fa !important;
  box-shadow: 0 0 0 3px rgba(37,99,235,.10) !important;
}

/* ================================================================
   16. FILE UPLOAD
   ================================================================ */

body:not(.eec-dark-mode) main input[type="file"] {
  background: #ffffff !important;
  color: #334155 !important;
  border-color: #cbd5e1 !important;
}

body:not(.eec-dark-mode) main input[type="file"]::file-selector-button {
  background: #f1f5f9 !important;
  color: #334155 !important;
  border: 0 !important;
}

/* ================================================================
   17. DROPDOWNS / PROFILE
   ================================================================ */

body:not(.eec-dark-mode) [role="menu"],
body:not(.eec-dark-mode) [role="dialog"],
body:not(.eec-dark-mode) .admin-pro-settings,
body:not(.eec-dark-mode) .admin-pro-profile-menu,
body:not(.eec-dark-mode) .admin-pro-dropdown {
  background: #ffffff !important;
  color: #0f172a !important;
  border-color: #e2e8f0 !important;
  opacity: 1 !important;
}

body:not(.eec-dark-mode) [role="menu"] svg,
body:not(.eec-dark-mode) [role="dialog"] svg {
  color: #475569 !important;
  stroke: currentColor !important;
}

/* ================================================================
   18. STATUS BADGES
   ================================================================ */

body:not(.eec-dark-mode) main .bg-green-100,
body:not(.eec-dark-mode) main .bg-emerald-100 {
  background: #dcfce7 !important;
  color: #166534 !important;
  border-color: #bbf7d0 !important;
}

body:not(.eec-dark-mode) main .bg-amber-100,
body:not(.eec-dark-mode) main .bg-yellow-100 {
  background: #fef3c7 !important;
  color: #92400e !important;
  border-color: #fde68a !important;
}

body:not(.eec-dark-mode) main .bg-red-100,
body:not(.eec-dark-mode) main .bg-rose-100 {
  background: #fee2e2 !important;
  color: #991b1b !important;
  border-color: #fecaca !important;
}

body:not(.eec-dark-mode) main .bg-blue-100 {
  background: #dbeafe !important;
  color: #1e40af !important;
}

/* ================================================================
   19. LINKS
   ================================================================ */

body:not(.eec-dark-mode) main a {
  opacity: 1 !important;
}

body:not(.eec-dark-mode) main a.text-brand-600,
body:not(.eec-dark-mode) main a.text-blue-600 {
  color: #2563eb !important;
}

/* ================================================================
   20. BUTTON ICONS
   ================================================================ */

body:not(.eec-dark-mode) main button svg {
  opacity: 1 !important;
}

/* Keep white text/icons on intentionally colored buttons */
body:not(.eec-dark-mode) main .bg-blue-600,
body:not(.eec-dark-mode) main .bg-blue-700,
body:not(.eec-dark-mode) main .bg-brand-600,
body:not(.eec-dark-mode) main .bg-brand-700 {
  color: #ffffff !important;
}

body:not(.eec-dark-mode) main .bg-blue-600 svg,
body:not(.eec-dark-mode) main .bg-blue-700 svg,
body:not(.eec-dark-mode) main .bg-brand-600 svg,
body:not(.eec-dark-mode) main .bg-brand-700 svg {
  color: #ffffff !important;
  stroke: currentColor !important;
}

/* ================================================================
   21. REMOVE LIGHT-MODE FADE
   ================================================================ */

body:not(.eec-dark-mode) main .opacity-50,
body:not(.eec-dark-mode) main .opacity-60,
body:not(.eec-dark-mode) main .opacity-70,
body:not(.eec-dark-mode) main .opacity-75 {
  opacity: 1 !important;
}

/* ================================================================
   22. SCROLLBAR
   ================================================================ */

body:not(.eec-dark-mode) ::-webkit-scrollbar-track {
  background: #f1f5f9;
}

body:not(.eec-dark-mode) ::-webkit-scrollbar-thumb {
  background: #cbd5e1;
}

body:not(.eec-dark-mode) ::-webkit-scrollbar-thumb:hover {
  background: #94a3b8;
}

/* ================================================================
   DARK MODE IS EXCLUDED FROM EVERYTHING ABOVE.
   ================================================================ */


/* =========================================================
   ADMIN PROFILE DROPDOWN — DARK MODE FINAL FIX
   ONLY targets the profile/settings popup.
   ========================================================= */

body.eec-dark-mode .admin-profile-dropdown,
body.eec-dark-mode .admin-settings-dropdown,
body.eec-dark-mode .admin-profile-menu,
body.eec-dark-mode .profile-dropdown,
body.eec-dark-mode .profile-menu,
body.eec-dark-mode .settings-dropdown,
body.eec-dark-mode [class*="profile-dropdown"],
body.eec-dark-mode [class*="profile-menu"],
body.eec-dark-mode [class*="settings-dropdown"] {
    background: #151d2d !important;
    background-color: #151d2d !important;
    color: #f8fafc !important;
    border: 1px solid #2d3a50 !important;
    box-shadow:
        0 20px 45px rgba(0, 0, 0, .45),
        0 0 0 1px rgba(255,255,255,.025) !important;
}

/* Popup text */
body.eec-dark-mode .admin-profile-dropdown *,
body.eec-dark-mode .admin-settings-dropdown *,
body.eec-dark-mode .admin-profile-menu *,
body.eec-dark-mode .profile-dropdown *,
body.eec-dark-mode .profile-menu *,
body.eec-dark-mode .settings-dropdown *,
body.eec-dark-mode [class*="profile-dropdown"] *,
body.eec-dark-mode [class*="profile-menu"] *,
body.eec-dark-mode [class*="settings-dropdown"] {
    color: inherit !important;
}

/* Main name */
body.eec-dark-mode .admin-profile-dropdown strong,
body.eec-dark-mode .admin-settings-dropdown strong,
body.eec-dark-mode .admin-profile-menu strong,
body.eec-dark-mode .profile-dropdown strong,
body.eec-dark-mode .profile-menu strong {
    color: #f8fafc !important;
}

/* Secondary text */
body.eec-dark-mode .admin-profile-dropdown small,
body.eec-dark-mode .admin-settings-dropdown small,
body.eec-dark-mode .admin-profile-menu small,
body.eec-dark-mode .profile-dropdown small,
body.eec-dark-mode .profile-menu small {
    color: #94a3b8 !important;
}

/* SETTINGS heading */
body.eec-dark-mode .admin-profile-dropdown .settings-title,
body.eec-dark-mode .admin-settings-dropdown .settings-title,
body.eec-dark-mode .profile-dropdown .settings-title {
    color: #94a3b8 !important;
}

/* Divider */
body.eec-dark-mode .admin-profile-dropdown hr,
body.eec-dark-mode .admin-settings-dropdown hr,
body.eec-dark-mode .admin-profile-menu hr,
body.eec-dark-mode .profile-dropdown hr,
body.eec-dark-mode .profile-menu hr {
    border-color: #2d3a50 !important;
    background: #2d3a50 !important;
}

/* Settings row */
body.eec-dark-mode .admin-profile-dropdown button,
body.eec-dark-mode .admin-settings-dropdown button,
body.eec-dark-mode .admin-profile-menu button,
body.eec-dark-mode .profile-dropdown button,
body.eec-dark-mode .profile-menu button {
    background: transparent !important;
    color: #e2e8f0 !important;
}

/* Dark-mode row */
body.eec-dark-mode .admin-profile-dropdown .setting-row,
body.eec-dark-mode .admin-settings-dropdown .setting-row,
body.eec-dark-mode .profile-dropdown .setting-row,
body.eec-dark-mode [class*="setting-row"] {
    background: #1b2537 !important;
    color: #f8fafc !important;
    border-color: #2d3a50 !important;
}

/* Setting icon container */
body.eec-dark-mode .admin-profile-dropdown .setting-icon,
body.eec-dark-mode .admin-settings-dropdown .setting-icon,
body.eec-dark-mode .profile-dropdown .setting-icon {
    background: #263248 !important;
    color: #cbd5e1 !important;
}

/* SVG icons */
body.eec-dark-mode .admin-profile-dropdown svg,
body.eec-dark-mode .admin-settings-dropdown svg,
body.eec-dark-mode .admin-profile-menu svg,
body.eec-dark-mode .profile-dropdown svg,
body.eec-dark-mode .profile-menu svg {
    color: #cbd5e1 !important;
    stroke: currentColor !important;
    opacity: 1 !important;
}

/* Logout */
body.eec-dark-mode .admin-profile-dropdown .logout,
body.eec-dark-mode .admin-settings-dropdown .logout,
body.eec-dark-mode .admin-profile-menu .logout,
body.eec-dark-mode .profile-dropdown .logout,
body.eec-dark-mode .profile-menu .logout,
body.eec-dark-mode button[class*="logout"] {
    background: rgba(244,63,94,.10) !important;
    color: #fb7185 !important;
    border: 1px solid rgba(244,63,94,.08) !important;
}

body.eec-dark-mode .admin-profile-dropdown .logout svg,
body.eec-dark-mode .admin-settings-dropdown .logout svg,
body.eec-dark-mode .profile-dropdown .logout svg,
body.eec-dark-mode button[class*="logout"] svg {
    color: #fb7185 !important;
}

/* Toggle */
body.eec-dark-mode .admin-profile-dropdown .switch,
body.eec-dark-mode .admin-settings-dropdown .switch,
body.eec-dark-mode .profile-dropdown .switch,
body.eec-dark-mode button[class*="switch"] {
    background: #334155 !important;
}

body.eec-dark-mode .admin-profile-dropdown .switch.on,
body.eec-dark-mode .admin-settings-dropdown .switch.on,
body.eec-dark-mode .profile-dropdown .switch.on,
body.eec-dark-mode button[class*="switch"].on {
    background: #2563eb !important;
}

/* Avatar */
body.eec-dark-mode .admin-profile-dropdown .avatar,
body.eec-dark-mode .admin-settings-dropdown .avatar,
body.eec-dark-mode .admin-profile-menu .avatar,
body.eec-dark-mode .profile-dropdown .avatar {
    background: linear-gradient(135deg,#2563eb,#4f46e5) !important;
    color: #ffffff !important;
}

/* Hover */
body.eec-dark-mode .admin-profile-dropdown button:hover,
body.eec-dark-mode .admin-settings-dropdown button:hover,
body.eec-dark-mode .admin-profile-menu button:hover,
body.eec-dark-mode .profile-dropdown button:hover,
body.eec-dark-mode .profile-menu button:hover {
    background: #202b3f !important;
}

/* =========================================================
   LIGHT MODE — DO NOTHING
   ========================================================= */


/* =========================================================
   FINAL ADMIN PROFILE DROPDOWN FIX
   Dark mode only
   ========================================================= */

/* Catch the actual popup regardless of its existing class */
body.eec-dark-mode nav > div > div:last-child > div,
body.eec-dark-mode nav > div > div:last-child > div[class],
body.eec-dark-mode nav div[class*="dropdown"],
body.eec-dark-mode nav div[class*="Dropdown"],
body.eec-dark-mode nav div[class*="profile"],
body.eec-dark-mode nav div[class*="Profile"],
body.eec-dark-mode nav div[class*="menu"],
body.eec-dark-mode nav div[class*="Menu"] {
    color: #f8fafc !important;
}

/* Any popup positioned over the page */
body.eec-dark-mode nav div[style*="position"],
body.eec-dark-mode nav div[style*="absolute"],
body.eec-dark-mode nav div[style*="fixed"] {
    color: #f8fafc !important;
}

/* DARK PROFILE PANEL */
body.eec-dark-mode nav div[class*="dropdown"],
body.eec-dark-mode nav div[class*="Dropdown"],
body.eec-dark-mode nav div[class*="profile-menu"],
body.eec-dark-mode nav div[class*="ProfileMenu"],
body.eec-dark-mode nav div[class*="profile-dropdown"],
body.eec-dark-mode nav div[class*="ProfileDropdown"],
body.eec-dark-mode nav div[class*="settings-menu"],
body.eec-dark-mode nav div[class*="SettingsMenu"] {
    background: #111827 !important;
    background-color: #111827 !important;
    color: #f8fafc !important;
    border-color: #263449 !important;
}

/* REMOVE WHITE PATCHES INSIDE POPUP */
body.eec-dark-mode nav div[class*="dropdown"] *,
body.eec-dark-mode nav div[class*="Dropdown"] *,
body.eec-dark-mode nav div[class*="profile-menu"] *,
body.eec-dark-mode nav div[class*="ProfileMenu"] *,
body.eec-dark-mode nav div[class*="profile-dropdown"] *,
body.eec-dark-mode nav div[class*="ProfileDropdown"] *,
body.eec-dark-mode nav div[class*="settings-menu"] *,
body.eec-dark-mode nav div[class*="SettingsMenu"] {
    border-color: #263449 !important;
}

/* WHITE CARDS / HEADERS INSIDE PROFILE */
body.eec-dark-mode nav div[class*="dropdown"] > div,
body.eec-dark-mode nav div[class*="Dropdown"] > div,
body.eec-dark-mode nav div[class*="profile-menu"] > div,
body.eec-dark-mode nav div[class*="ProfileMenu"] > div,
body.eec-dark-mode nav div[class*="profile-dropdown"] > div,
body.eec-dark-mode nav div[class*="ProfileDropdown"] > div {
    background: transparent !important;
    color: #f8fafc !important;
}

/* PROFILE TEXT */
body.eec-dark-mode nav div[class*="dropdown"] strong,
body.eec-dark-mode nav div[class*="Dropdown"] strong,
body.eec-dark-mode nav div[class*="profile"] strong,
body.eec-dark-mode nav div[class*="Profile"] strong {
    color: #f8fafc !important;
}

body.eec-dark-mode nav div[class*="dropdown"] small,
body.eec-dark-mode nav div[class*="Dropdown"] small,
body.eec-dark-mode nav div[class*="profile"] small,
body.eec-dark-mode nav div[class*="Profile"] small {
    color: #94a3b8 !important;
}

/* SETTINGS LABEL */
body.eec-dark-mode nav div[class*="dropdown"] label,
body.eec-dark-mode nav div[class*="Dropdown"] label,
body.eec-dark-mode nav div[class*="settings"] label,
body.eec-dark-mode nav div[class*="Settings"] label {
    color: #94a3b8 !important;
}

/* BUTTONS */
body.eec-dark-mode nav div[class*="dropdown"] button,
body.eec-dark-mode nav div[class*="Dropdown"] button,
body.eec-dark-mode nav div[class*="profile"] button,
body.eec-dark-mode nav div[class*="Profile"] button {
    color: #e5e7eb !important;
    background: transparent !important;
}

/* HOVER */
body.eec-dark-mode nav div[class*="dropdown"] button:hover,
body.eec-dark-mode nav div[class*="Dropdown"] button:hover,
body.eec-dark-mode nav div[class*="profile"] button:hover,
body.eec-dark-mode nav div[class*="Profile"] button:hover {
    background: #1e293b !important;
}

/* DIVIDERS */
body.eec-dark-mode nav div[class*="dropdown"] hr,
body.eec-dark-mode nav div[class*="Dropdown"] hr,
body.eec-dark-mode nav div[class*="profile"] hr,
body.eec-dark-mode nav div[class*="Profile"] hr {
    border-color: #263449 !important;
    background: #263449 !important;
}

/* SVG */
body.eec-dark-mode nav div[class*="dropdown"] svg,
body.eec-dark-mode nav div[class*="Dropdown"] svg,
body.eec-dark-mode nav div[class*="profile"] svg,
body.eec-dark-mode nav div[class*="Profile"] svg {
    color: #cbd5e1 !important;
    stroke: currentColor !important;
    opacity: 1 !important;
}

/* LOGOUT */
body.eec-dark-mode nav button[class*="logout"],
body.eec-dark-mode nav button[class*="Logout"],
body.eec-dark-mode nav div[class*="dropdown"] button:last-child {
    color: #fb7185 !important;
}

/* TOGGLE */
body.eec-dark-mode nav input[type="checkbox"] {
    accent-color: #2563eb !important;
}

/* =========================================================
   KILL COMMON LIGHT-MODE TAILWIND BACKGROUNDS
   ONLY INSIDE NAV POPUPS
   ========================================================= */

body.eec-dark-mode nav div[class*="dropdown"] .bg-white,
body.eec-dark-mode nav div[class*="Dropdown"] .bg-white,
body.eec-dark-mode nav div[class*="profile"] .bg-white,
body.eec-dark-mode nav div[class*="Profile"] .bg-white,
body.eec-dark-mode nav div[class*="dropdown"] .bg-slate-50,
body.eec-dark-mode nav div[class*="Dropdown"] .bg-slate-50,
body.eec-dark-mode nav div[class*="profile"] .bg-slate-50,
body.eec-dark-mode nav div[class*="Profile"] .bg-slate-50 {
    background: #111827 !important;
}

/* =========================================================
   IMPORTANT: LIGHT MODE IS NOT MODIFIED
   ========================================================= */

