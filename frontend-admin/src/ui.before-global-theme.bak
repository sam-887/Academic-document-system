/* =========================================================
   ADMIN PORTAL — CLEAN PREMIUM UI
   Light + Dark adaptive theme
   ========================================================= */

:root {
  --bg: #f5f7fb;
  --surface: #ffffff;
  --surface-soft: #f8fafc;

  --text: #172033;
  --text-secondary: #64748b;
  --text-muted: #94a3b8;

  --border: #e7ebf2;

  --primary: #2563eb;
  --primary-soft: #eff6ff;

  --green: #16a34a;
  --green-soft: #f0fdf4;

  --amber: #d97706;
  --amber-soft: #fffbeb;

  --red: #dc2626;
  --red-soft: #fef2f2;

  --shadow-sm:
    0 2px 8px rgba(15,23,42,.04);

  --shadow:
    0 8px 25px rgba(15,23,42,.06);

  --radius: 18px;
}

/* =========================================================
   DARK THEME
   ========================================================= */

body.eec-dark-mode {

  --bg: #080c13;
  --surface: #111722;
  --surface-soft: #151d29;

  --text: #f1f5f9;
  --text-secondary: #a8b3c5;
  --text-muted: #718096;

  --border: rgba(148,163,184,.13);

  --primary: #60a5fa;
  --primary-soft: rgba(59,130,246,.11);

  --green: #4ade80;
  --green-soft: rgba(34,197,94,.10);

  --amber: #fbbf24;
  --amber-soft: rgba(245,158,11,.10);

  --red: #fb7185;
  --red-soft: rgba(244,63,94,.10);

  --shadow-sm:
    0 4px 16px rgba(0,0,0,.22);

  --shadow:
    0 15px 40px rgba(0,0,0,.28);
}

/* =========================================================
   PAGE
   ========================================================= */

body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  transition:
    background .35s ease,
    color .35s ease;
}

.admin-dashboard {
  min-height: 100vh;
  padding: 34px;
  background: var(--bg);
  color: var(--text);
}

/* =========================================================
   HEADER
   ========================================================= */

.dashboard-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 20px;
  margin-bottom: 30px;
}

.dashboard-eyebrow {
  display: block;
  margin-bottom: 7px;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: .14em;
  color: var(--primary);
}

.dashboard-header h1 {
  margin: 0;
  font-size: 32px;
  line-height: 1.15;
  font-weight: 750;
  letter-spacing: -.03em;
  color: var(--text);
}

.dashboard-header p {
  margin: 9px 0 0;
  color: var(--text-secondary);
  font-size: 14px;
}

.refresh-btn {
  display: flex;
  align-items: center;
  gap: 8px;

  border: 1px solid var(--border);
  background: var(--surface);

  color: var(--text);

  padding: 10px 15px;
  border-radius: 11px;

  font-size: 13px;
  font-weight: 650;

  cursor: pointer;

  box-shadow: var(--shadow-sm);

  transition:
    background .2s ease,
    border-color .2s ease,
    box-shadow .2s ease;
}

.refresh-btn:hover {
  border-color: rgba(96,165,250,.35);
  box-shadow: 0 5px 18px rgba(37,99,235,.08);
}

/* =========================================================
   STAT CARDS
   ========================================================= */

.stats-grid {
  display: grid;
  grid-template-columns:
    repeat(4, minmax(0, 1fr));

  gap: 18px;

  margin-bottom: 25px;
}

.stat-card {
  position: relative;

  display: flex;
  align-items: center;
  gap: 16px;

  min-height: 105px;
  padding: 20px;

  background: var(--surface);

  border: 1px solid var(--border);
  border-radius: var(--radius);

  box-shadow: var(--shadow-sm);

  overflow: hidden;

  transition:
    border-color .25s ease,
    box-shadow .3s ease,
    background .3s ease;
}

.stat-card:hover {
  border-color: rgba(96,165,250,.22);

  box-shadow:
    0 12px 30px rgba(15,23,42,.08);
}

body.eec-dark-mode .stat-card:hover {
  box-shadow:
    0 15px 35px rgba(0,0,0,.32),
    0 0 25px rgba(59,130,246,.035);
}

.stat-icon {
  width: 46px;
  height: 46px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 13px;

  font-size: 20px;
  font-weight: 700;
}

.stat-card span {
  display: block;

  color: var(--text-secondary);

  font-size: 12px;
  font-weight: 600;

  margin-bottom: 6px;
}

.stat-card strong {
  display: block;

  color: var(--text);

  font-size: 25px;
  line-height: 1;
}

/* individual accents */

.stat-total .stat-icon {
  color: var(--primary);
  background: var(--primary-soft);
}

.stat-pending .stat-icon {
  color: var(--amber);
  background: var(--amber-soft);
}

.stat-approved .stat-icon {
  color: var(--green);
  background: var(--green-soft);
}

.stat-rejected .stat-icon {
  color: var(--red);
  background: var(--red-soft);
}

/* =========================================================
   REQUEST PANEL
   ========================================================= */

.requests-panel {
  background: var(--surface);

  border:
    1px solid var(--border);

  border-radius: 20px;

  box-shadow: var(--shadow);

  overflow: hidden;

  transition:
    background .3s ease,
    border-color .3s ease,
    box-shadow .3s ease;
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;

  gap: 20px;

  padding: 23px 25px;

  border-bottom:
    1px solid var(--border);
}

.panel-header h2 {
  margin: 0;

  color: var(--text);

  font-size: 17px;
  font-weight: 720;
}

.panel-header p {
  margin: 5px 0 0;

  color: var(--text-secondary);

  font-size: 12px;
}

/* =========================================================
   FILTER
   ========================================================= */

.filter-group {
  display: flex;
  gap: 4px;

  padding: 4px;

  background: var(--surface-soft);

  border: 1px solid var(--border);

  border-radius: 10px;
}

.filter-group button {
  border: 0;

  background: transparent;

  color: var(--text-secondary);

  padding: 7px 12px;

  border-radius: 7px;

  font-size: 12px;
  font-weight: 650;

  cursor: pointer;

  transition:
    background .2s ease,
    color .2s ease,
    box-shadow .2s ease;
}

.filter-group button:hover {
  color: var(--text);
}

.filter-group button.active {
  color: var(--text);

  background: var(--surface);

  box-shadow:
    0 2px 7px rgba(15,23,42,.07);
}

body.eec-dark-mode .filter-group button.active {
  box-shadow:
    0 2px 10px rgba(0,0,0,.25);
}

/* =========================================================
   TABLE
   ========================================================= */

.request-table-wrap {
  overflow-x: auto;
}

.request-table {
  width: 100%;

  border-collapse: collapse;
}

.request-table th {
  padding: 13px 25px;

  text-align: left;

  background: var(--surface-soft);

  color: var(--text-muted);

  font-size: 10px;
  font-weight: 800;

  text-transform: uppercase;
  letter-spacing: .08em;
}

.request-table td {
  padding: 17px 25px;

  color: var(--text-secondary);

  font-size: 13px;

  border-top:
    1px solid var(--border);
}

.request-table tbody tr {
  transition:
    background .2s ease;
}

.request-table tbody tr:hover {
  background:
    rgba(59,130,246,.025);
}

/* =========================================================
   STUDENT
   ========================================================= */

.student-cell {
  display: flex;
  align-items: center;
  gap: 12px;
}

.student-avatar {
  width: 36px;
  height: 36px;

  flex-shrink: 0;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 10px;

  background: var(--primary-soft);
  color: var(--primary);

  font-size: 13px;
  font-weight: 800;
}

.student-cell strong {
  display: block;

  color: var(--text);

  font-size: 13px;
  font-weight: 680;
}

.student-cell span {
  display: block;

  margin-top: 3px;

  color: var(--text-muted);

  font-size: 11px;
}

.document-name {
  color: var(--text);
  font-weight: 600;
}

/* =========================================================
   EMPTY / LOADING
   ========================================================= */

.dashboard-empty {
  min-height: 250px;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  text-align: center;
}

.dashboard-empty p {
  color: var(--text-secondary);
  font-size: 13px;
}

.dashboard-empty h3 {
  margin: 10px 0 0;

  color: var(--text);

  font-size: 15px;
}

.empty-icon {
  width: 45px;
  height: 45px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 12px;

  background: var(--surface-soft);

  color: var(--text-muted);

  font-size: 20px;
}

.loading-ring {
  width: 26px;
  height: 26px;

  border:
    3px solid var(--border);

  border-top-color:
    var(--primary);

  border-radius: 50%;

  animation:
    admin-spin .8s linear infinite;
}

@keyframes admin-spin {
  to {
    transform: rotate(360deg);
  }
}

/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 1000px) {

  .stats-grid {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 700px) {

  .admin-dashboard {
    padding: 20px;
  }

  .dashboard-header,
  .panel-header {
    align-items: flex-start;
    flex-direction: column;
  }

  .stats-grid {
    grid-template-columns: 1fr;
  }

  .filter-group {
    width: 100%;
    overflow-x: auto;
  }

  .filter-group button {
    white-space: nowrap;
  }
}

/* =========================================================
   GLOBAL DARK-MODE SAFETY
   ========================================================= */

body.eec-dark-mode input,
body.eec-dark-mode textarea,
body.eec-dark-mode select {
  background: #0c131d !important;
  color: #e5e7eb !important;
  border-color: var(--border) !important;
}

body.eec-dark-mode input::placeholder,
body.eec-dark-mode textarea::placeholder {
  color: #64748b !important;
}

body.eec-dark-mode .bg-white {
  background: var(--surface) !important;
}

body.eec-dark-mode .bg-gray-50,
body.eec-dark-mode .bg-slate-50 {
  background: var(--surface-soft) !important;
}

body.eec-dark-mode .text-gray-900,
body.eec-dark-mode .text-slate-900 {
  color: var(--text) !important;
}

body.eec-dark-mode .text-gray-700,
body.eec-dark-mode .text-slate-700 {
  color: var(--text-secondary) !important;
}

body.eec-dark-mode .text-gray-500,
body.eec-dark-mode .text-slate-500 {
  color: var(--text-muted) !important;
}

/* Don't make buttons/cards jump around */
body.eec-dark-mode button:hover {
  transform: none !important;
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation: none !important;
    transition: none !important;
  }
}

/* ============================================================
   EEC ADMIN — PREMIUM NAVBAR
   Works with existing Navbar.js
   ============================================================ */

.admin-pro-navbar {
  position: sticky;
  top: 0;
  z-index: 1000;

  width: 100%;

  background: rgba(255, 255, 255, 0.92);

  border-bottom: 1px solid #e7ebf2;

  box-shadow:
    0 4px 20px rgba(15, 23, 42, 0.045);

  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);

  transition:
    background 0.35s ease,
    border-color 0.35s ease,
    box-shadow 0.35s ease;
}


/* ============================================================
   INNER
   ============================================================ */

.admin-pro-inner {
  width: min(1440px, calc(100% - 48px));

  min-height: 76px;

  margin: 0 auto;

  display: flex;
  align-items: center;

  gap: 28px;
}


/* ============================================================
   BRAND
   ============================================================ */

.admin-pro-brand {
  display: flex;
  align-items: center;

  gap: 12px;

  min-width: 255px;

  color: inherit;
  text-decoration: none;

  flex-shrink: 0;
}


/* Logo */

.admin-pro-logo {
  width: 42px;
  height: 42px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 13px;

  color: #2563eb;

  background:
    linear-gradient(
      145deg,
      #eff6ff,
      #dbeafe
    );

  border: 1px solid rgba(37, 99, 235, 0.10);

  box-shadow:
    0 5px 14px rgba(37, 99, 235, 0.10);

  transition:
    box-shadow .3s ease,
    border-color .3s ease,
    background .3s ease;
}

.admin-pro-brand:hover .admin-pro-logo {
  border-color: rgba(37,99,235,.22);

  box-shadow:
    0 7px 18px rgba(37,99,235,.15);
}


/* Brand text */

.admin-pro-brand-copy {
  display: flex;
  flex-direction: column;

  min-width: 0;
}

.admin-pro-brand-copy strong {
  color: #172033;

  font-size: 14px;
  font-weight: 760;

  letter-spacing: -.015em;

  line-height: 1.2;
}

.admin-pro-brand-copy small {
  margin-top: 4px;

  color: #8a96a8;

  font-size: 10px;
  font-weight: 520;

  white-space: nowrap;
}


/* ============================================================
   NAV LINKS
   ============================================================ */

.admin-pro-nav-links {
  flex: 1;

  display: flex;
  align-items: center;

  justify-content: center;

  gap: 4px;
}


/* Individual link */

.admin-pro-nav-link {
  position: relative;

  display: inline-flex;
  align-items: center;

  gap: 8px;

  padding: 10px 13px;

  border-radius: 11px;

  color: #687589;

  text-decoration: none;

  font-size: 12px;
  font-weight: 650;

  white-space: nowrap;

  transition:
    color .22s ease,
    background .22s ease,
    box-shadow .25s ease;
}


/* Icon */

.admin-pro-nav-link svg {
  flex-shrink: 0;

  opacity: .78;

  transition:
    opacity .22s ease;
}


/* Hover */

.admin-pro-nav-link:hover {
  color: #1e293b;

  background:
    rgba(37,99,235,.055);
}

.admin-pro-nav-link:hover svg {
  opacity: 1;
}


/* ============================================================
   ACTIVE NAV
   ============================================================ */

.admin-pro-nav-link.active {
  color: #2563eb;

  background:
    linear-gradient(
      135deg,
      rgba(37,99,235,.10),
      rgba(59,130,246,.055)
    );

  box-shadow:
    inset 0 0 0 1px rgba(37,99,235,.07);
}

.admin-pro-nav-link.active svg {
  opacity: 1;
}


/* Small active indicator */

.admin-pro-nav-link.active::after {
  content: "";

  position: absolute;

  left: 50%;
  bottom: -1px;

  width: 20px;
  height: 2px;

  transform: translateX(-50%);

  border-radius: 99px;

  background: #3b82f6;

  box-shadow:
    0 0 10px rgba(59,130,246,.22);
}


/* ============================================================
   PROFILE AREA
   ============================================================ */

.admin-pro-profile-wrap {
  position: relative;

  flex-shrink: 0;
}


/* Profile button */

.admin-pro-profile {
  display: flex;
  align-items: center;

  gap: 9px;

  min-width: 174px;

  padding: 7px 9px;

  border: 1px solid transparent;

  border-radius: 13px;

  background: transparent;

  color: #172033;

  cursor: pointer;

  text-align: left;

  transition:
    background .22s ease,
    border-color .22s ease,
    box-shadow .25s ease;
}

.admin-pro-profile:hover,
.admin-pro-profile.open {
  background: #f8fafc;

  border-color: #e7ebf2;

  box-shadow:
    0 5px 18px rgba(15,23,42,.055);
}


/* Avatar */

.admin-pro-avatar {
  width: 36px;
  height: 36px;

  flex-shrink: 0;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 11px;

  color: #2563eb;

  background:
    linear-gradient(
      145deg,
      #eff6ff,
      #dbeafe
    );

  border: 1px solid rgba(37,99,235,.10);

  font-size: 13px;
  font-weight: 800;

  box-shadow:
    0 3px 10px rgba(37,99,235,.08);
}


/* Profile text */

.admin-pro-profile-copy {
  min-width: 0;

  flex: 1;

  display: flex;
  flex-direction: column;
}

.admin-pro-profile-copy strong {
  overflow: hidden;

  color: #1e293b;

  font-size: 12px;
  font-weight: 700;

  text-overflow: ellipsis;
  white-space: nowrap;
}

.admin-pro-profile-copy small {
  margin-top: 3px;

  color: #94a3b8;

  font-size: 10px;
  font-weight: 550;
}


/* Chevron */

.admin-pro-profile > svg {
  color: #94a3b8;

  transition:
    transform .25s ease,
    color .2s ease;
}

.admin-pro-profile.open > svg {
  transform: rotate(180deg);

  color: #64748b;
}


/* ============================================================
   DROPDOWN
   ============================================================ */

.admin-pro-dropdown {
  position: absolute;

  top: calc(100% + 10px);
  right: 0;

  width: 285px;

  padding: 9px;

  border-radius: 17px;

  background: rgba(255,255,255,.97);

  border:
    1px solid #e4e9f1;

  box-shadow:
    0 20px 50px rgba(15,23,42,.13),
    0 4px 14px rgba(15,23,42,.06);

  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);

  animation:
    admin-dropdown-in .22s cubic-bezier(.22,1,.36,1);
}

@keyframes admin-dropdown-in {
  from {
    opacity: 0;
    transform: translateY(-5px) scale(.985);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}


/* Dropdown header */

.admin-pro-dropdown-head {
  display: flex;
  align-items: center;

  gap: 11px;

  padding: 12px;

  border-radius: 12px;

  background:
    linear-gradient(
      135deg,
      #f8fafc,
      #f1f5f9
    );

  border: 1px solid #edf1f5;
}

.admin-pro-dropdown-head .large {
  width: 40px;
  height: 40px;
}

.admin-pro-dropdown-head div {
  min-width: 0;
}

.admin-pro-dropdown-head strong {
  display: block;

  color: #172033;

  font-size: 13px;
  font-weight: 720;
}

.admin-pro-dropdown-head small {
  display: block;

  margin-top: 3px;

  color: #8b97a8;

  font-size: 10px;
}


/* ============================================================
   SETTINGS TITLE
   ============================================================ */

.admin-pro-settings-title {
  padding:
    16px 12px 7px;

  color: #9aa5b4;

  font-size: 9px;
  font-weight: 800;

  letter-spacing: .12em;
}


/* ============================================================
   SETTING ROW
   ============================================================ */

.admin-pro-setting-row {
  width: 100%;

  display: flex;
  align-items: center;

  gap: 10px;

  padding: 10px;

  border: 0;

  border-radius: 11px;

  background: transparent;

  color: #172033;

  cursor: pointer;

  text-align: left;

  transition:
    background .2s ease;
}

.admin-pro-setting-row:hover {
  background: #f5f8fc;
}


/* Setting icon */

.admin-pro-setting-icon {
  width: 34px;
  height: 34px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 10px;

  color: #64748b;

  background: #f1f5f9;

  transition:
    color .2s ease,
    background .2s ease;
}

.admin-pro-setting-row:hover .admin-pro-setting-icon {
  color: #2563eb;

  background: #eff6ff;
}


/* Setting text */

.admin-pro-setting-copy {
  flex: 1;

  display: flex;
  flex-direction: column;
}

.admin-pro-setting-copy strong {
  color: #334155;

  font-size: 12px;
  font-weight: 680;
}

.admin-pro-setting-copy small {
  margin-top: 3px;

  color: #94a3b8;

  font-size: 10px;
}


/* ============================================================
   SWITCH
   ============================================================ */

.admin-pro-switch {
  width: 35px;
  height: 20px;

  padding: 2px;

  display: flex;
  align-items: center;

  border-radius: 99px;

  background: #cbd5e1;

  transition:
    background .25s ease;
}

.admin-pro-switch span {
  width: 16px;
  height: 16px;

  display: block;

  border-radius: 50%;

  background: white;

  box-shadow:
    0 1px 4px rgba(15,23,42,.18);

  transition:
    transform .25s cubic-bezier(.22,1,.36,1);
}

.admin-pro-switch.on {
  background: #2563eb;
}

.admin-pro-switch.on span {
  transform: translateX(15px);
}


/* ============================================================
   DIVIDER
   ============================================================ */

.admin-pro-divider {
  height: 1px;

  margin:
    7px 5px;

  background: #edf0f4;
}


/* ============================================================
   LOGOUT
   ============================================================ */

.admin-pro-logout {
  width: 100%;

  display: flex;
  align-items: center;

  gap: 10px;

  padding: 10px;

  border: 0;

  border-radius: 11px;

  background: transparent;

  color: #64748b;

  cursor: pointer;

  font-size: 12px;
  font-weight: 650;

  text-align: left;

  transition:
    background .2s ease,
    color .2s ease;
}

.admin-pro-logout:hover {
  color: #dc2626;

  background: #fef2f2;
}


/* ============================================================
   DARK MODE
   ============================================================ */

html.eec-dark-mode .admin-pro-navbar,
body.eec-dark-mode .admin-pro-navbar {

  background:
    rgba(10,15,23,.88);

  border-bottom:
    1px solid rgba(148,163,184,.12);

  box-shadow:
    0 5px 25px rgba(0,0,0,.25);
}


/* Dark brand */

html.eec-dark-mode .admin-pro-brand-copy strong,
body.eec-dark-mode .admin-pro-brand-copy strong {
  color: #f1f5f9;
}

html.eec-dark-mode .admin-pro-brand-copy small,
body.eec-dark-mode .admin-pro-brand-copy small {
  color: #64748b;
}

html.eec-dark-mode .admin-pro-logo,
body.eec-dark-mode .admin-pro-logo {

  color: #60a5fa;

  background:
    linear-gradient(
      145deg,
      rgba(59,130,246,.16),
      rgba(37,99,235,.08)
    );

  border-color:
    rgba(96,165,250,.13);

  box-shadow:
    0 5px 18px rgba(37,99,235,.10);
}


/* Dark nav */

html.eec-dark-mode .admin-pro-nav-link,
body.eec-dark-mode .admin-pro-nav-link {
  color: #8995a8;
}

html.eec-dark-mode .admin-pro-nav-link:hover,
body.eec-dark-mode .admin-pro-nav-link:hover {

  color: #e2e8f0;

  background:
    rgba(59,130,246,.075);
}

html.eec-dark-mode .admin-pro-nav-link.active,
body.eec-dark-mode .admin-pro-nav-link.active {

  color: #60a5fa;

  background:
    linear-gradient(
      135deg,
      rgba(59,130,246,.14),
      rgba(59,130,246,.055)
    );

  box-shadow:
    inset 0 0 0 1px rgba(96,165,250,.08);
}


/* Dark profile */

html.eec-dark-mode .admin-pro-profile,
body.eec-dark-mode .admin-pro-profile {
  color: #e2e8f0;
}

html.eec-dark-mode .admin-pro-profile:hover,
html.eec-dark-mode .admin-pro-profile.open,
body.eec-dark-mode .admin-pro-profile:hover,
body.eec-dark-mode .admin-pro-profile.open {

  background:
    rgba(30,41,59,.55);

  border-color:
    rgba(148,163,184,.13);

  box-shadow:
    0 8px 24px rgba(0,0,0,.22);
}

html.eec-dark-mode .admin-pro-profile-copy strong,
body.eec-dark-mode .admin-pro-profile-copy strong {
  color: #e5e7eb;
}

html.eec-dark-mode .admin-pro-profile-copy small,
body.eec-dark-mode .admin-pro-profile-copy small {
  color: #64748b;
}

html.eec-dark-mode .admin-pro-avatar,
body.eec-dark-mode .admin-pro-avatar {

  color: #60a5fa;

  background:
    linear-gradient(
      145deg,
      rgba(59,130,246,.18),
      rgba(37,99,235,.08)
    );

  border-color:
    rgba(96,165,250,.13);
}


/* Dark dropdown */

html.eec-dark-mode .admin-pro-dropdown,
body.eec-dark-mode .admin-pro-dropdown {

  background:
    rgba(15,22,33,.97);

  border-color:
    rgba(148,163,184,.14);

  box-shadow:
    0 25px 65px rgba(0,0,0,.50),
    0 5px 18px rgba(0,0,0,.28);
}

html.eec-dark-mode .admin-pro-dropdown-head,
body.eec-dark-mode .admin-pro-dropdown-head {

  background:
    linear-gradient(
      135deg,
      #172131,
      #111925
    );

  border-color:
    rgba(148,163,184,.10);
}

html.eec-dark-mode .admin-pro-dropdown-head strong,
body.eec-dark-mode .admin-pro-dropdown-head strong {
  color: #f1f5f9;
}

html.eec-dark-mode .admin-pro-dropdown-head small,
body.eec-dark-mode .admin-pro-dropdown-head small {
  color: #64748b;
}

html.eec-dark-mode .admin-pro-settings-title,
body.eec-dark-mode .admin-pro-settings-title {
  color: #64748b;
}


/* Dark setting */

html.eec-dark-mode .admin-pro-setting-row,
body.eec-dark-mode .admin-pro-setting-row {
  color: #e2e8f0;
}

html.eec-dark-mode .admin-pro-setting-row:hover,
body.eec-dark-mode .admin-pro-setting-row:hover {
  background:
    rgba(59,130,246,.055);
}

html.eec-dark-mode .admin-pro-setting-icon,
body.eec-dark-mode .admin-pro-setting-icon {

  color: #94a3b8;

  background:
    #182231;
}

html.eec-dark-mode .admin-pro-setting-row:hover .admin-pro-setting-icon,
body.eec-dark-mode .admin-pro-setting-row:hover .admin-pro-setting-icon {

  color: #60a5fa;

  background:
    rgba(59,130,246,.12);
}

html.eec-dark-mode .admin-pro-setting-copy strong,
body.eec-dark-mode .admin-pro-setting-copy strong {
  color: #dbe4ef;
}

html.eec-dark-mode .admin-pro-setting-copy small,
body.eec-dark-mode .admin-pro-setting-copy small {
  color: #64748b;
}


/* Dark divider */

html.eec-dark-mode .admin-pro-divider,
body.eec-dark-mode .admin-pro-divider {
  background:
    rgba(148,163,184,.09);
}


/* Dark logout */

html.eec-dark-mode .admin-pro-logout,
body.eec-dark-mode .admin-pro-logout {
  color: #94a3b8;
}

html.eec-dark-mode .admin-pro-logout:hover,
body.eec-dark-mode .admin-pro-logout:hover {

  color: #fb7185;

  background:
    rgba(244,63,94,.08);
}


/* ============================================================
   RESPONSIVE
   ============================================================ */

@media (max-width: 1050px) {

  .admin-pro-inner {
    width: min(100% - 32px, 1440px);
    gap: 15px;
  }

  .admin-pro-brand {
    min-width: auto;
  }

  .admin-pro-brand-copy small {
    display: none;
  }

  .admin-pro-nav-link span {
    display: none;
  }

  .admin-pro-nav-link {
    padding: 10px;
  }

  .admin-pro-profile {
    min-width: auto;
  }

  .admin-pro-profile-copy {
    display: none;
  }
}

@media (max-width: 650px) {

  .admin-pro-inner {
    min-height: 66px;
    width: calc(100% - 20px);
  }

  .admin-pro-brand-copy {
    display: none;
  }

  .admin-pro-nav-links {
    justify-content: flex-end;
  }

  .admin-pro-profile {
    padding: 5px;
  }

  .admin-pro-dropdown {
    right: -5px;
    width: 270px;
  }
}


/* ============================================================
   NO MOVEMENT / NO JANK
   ============================================================ */

.admin-pro-navbar *,
.admin-pro-navbar *::before,
.admin-pro-navbar *::after {
  box-sizing: border-box;
}

.admin-pro-nav-link,
.admin-pro-profile,
.admin-pro-setting-row,
.admin-pro-logout,
.admin-pro-logo {
  transform: none;
}

.admin-pro-nav-link:hover,
.admin-pro-profile:hover,
.admin-pro-setting-row:hover,
.admin-pro-logout:hover,
.admin-pro-logo:hover {
  transform: none;
}


/* Reduced motion */

@media (prefers-reduced-motion: reduce) {
  .admin-pro-navbar *,
  .admin-pro-navbar *::before,
  .admin-pro-navbar *::after {
    animation: none !important;
    transition: none !important;
  }
}


/* ============================================================
   FINAL CARD FINISH — NO VISIBLE STROKES
   ============================================================ */

.admin-dashboard .stat-card,
.admin-dashboard .requests-panel,
.admin-dashboard .request-table-wrap {
  border: none !important;
  outline: none !important;
}

/* Soft separation comes from shadow, NOT borders */

.admin-dashboard .stat-card {
  box-shadow:
    0 8px 25px rgba(15,23,42,.055),
    0 1px 3px rgba(15,23,42,.035) !important;

  animation:
    cardEnter .55s cubic-bezier(.22,1,.36,1) both;
}

.admin-dashboard .requests-panel {
  box-shadow:
    0 12px 35px rgba(15,23,42,.065),
    0 2px 6px rgba(15,23,42,.035) !important;

  animation:
    panelEnter .65s cubic-bezier(.22,1,.36,1) both;
}


/* ============================================================
   DARK MODE — SOFT FLOATING SURFACES
   ============================================================ */

body.eec-dark-mode .admin-dashboard .stat-card,
html.eec-dark-mode .admin-dashboard .stat-card {

  border: none !important;

  background:
    linear-gradient(
      145deg,
      rgba(23,31,44,.98),
      rgba(15,22,32,.98)
    ) !important;

  box-shadow:
    0 12px 32px rgba(0,0,0,.30),
    0 3px 9px rgba(0,0,0,.18) !important;
}

body.eec-dark-mode .admin-dashboard .requests-panel,
html.eec-dark-mode .admin-dashboard .requests-panel {

  border: none !important;

  background:
    linear-gradient(
      145deg,
      rgba(18,25,36,.99),
      rgba(12,18,27,.99)
    ) !important;

  box-shadow:
    0 18px 45px rgba(0,0,0,.34),
    0 4px 12px rgba(0,0,0,.20) !important;
}


/* ============================================================
   CARD HOVER — SOFT LIGHTING
   ============================================================ */

.admin-dashboard .stat-card {
  transition:
    transform .38s cubic-bezier(.22,1,.36,1),
    box-shadow .38s ease,
    background .38s ease !important;
}

.admin-dashboard .stat-card:hover {

  transform: translateY(-4px) !important;

  box-shadow:
    0 18px 38px rgba(15,23,42,.10),
    0 5px 12px rgba(15,23,42,.045) !important;
}

body.eec-dark-mode .admin-dashboard .stat-card:hover,
html.eec-dark-mode .admin-dashboard .stat-card:hover {

  transform: translateY(-4px) !important;

  box-shadow:
    0 20px 42px rgba(0,0,0,.42),
    0 0 28px rgba(59,130,246,.045) !important;
}


/* ============================================================
   COLOURED AMBIENT GLOW
   ============================================================ */

.admin-dashboard .stat-card {
  overflow: hidden;
}

.admin-dashboard .stat-card::after {
  content: "";

  position: absolute;

  width: 120px;
  height: 120px;

  right: -55px;
  top: -65px;

  border-radius: 50%;

  opacity: 0;

  filter: blur(35px);

  transition:
    opacity .45s ease,
    transform .55s cubic-bezier(.22,1,.36,1);
}

.admin-dashboard .stat-card:hover::after {
  opacity: .55;
  transform: scale(1.15);
}


/* Different ambient colours */

.stat-total::after {
  background: rgba(59,130,246,.16);
}

.stat-pending::after {
  background: rgba(245,158,11,.15);
}

.stat-approved::after {
  background: rgba(34,197,94,.14);
}

.stat-rejected::after {
  background: rgba(239,68,68,.13);
}


/* ============================================================
   ICON MICRO-ANIMATION
   ============================================================ */

.admin-dashboard .stat-icon {
  transition:
    transform .4s cubic-bezier(.22,1,.36,1),
    box-shadow .35s ease;
}

.admin-dashboard .stat-card:hover .stat-icon {

  transform:
    scale(1.07)
    rotate(-2deg);

  box-shadow:
    0 6px 15px rgba(37,99,235,.08);
}


/* ============================================================
   REQUEST ROW ANIMATION
   ============================================================ */

.admin-dashboard .request-table tbody tr {

  transition:
    background .25s ease,
    transform .25s ease;
}

.admin-dashboard .request-table tbody tr:hover {

  transform: translateX(3px) !important;

  background:
    rgba(59,130,246,.035) !important;
}


/* ============================================================
   ENTRANCE ANIMATIONS
   ============================================================ */

@keyframes cardEnter {

  from {
    opacity: 0;
    transform: translateY(14px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes panelEnter {

  from {
    opacity: 0;
    transform: translateY(18px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}


/* Stagger the stat cards */

.admin-dashboard .stat-card:nth-child(1) {
  animation-delay: .04s;
}

.admin-dashboard .stat-card:nth-child(2) {
  animation-delay: .09s;
}

.admin-dashboard .stat-card:nth-child(3) {
  animation-delay: .14s;
}

.admin-dashboard .stat-card:nth-child(4) {
  animation-delay: .19s;
}


/* ============================================================
   REMOVE OLD BORDER EFFECTS
   ============================================================ */

.admin-dashboard .stat-card *,
.admin-dashboard .requests-panel *,
.admin-dashboard .request-table-wrap {
  outline-color: transparent !important;
}

body.eec-dark-mode .admin-dashboard .stat-card,
body.eec-dark-mode .admin-dashboard .requests-panel,
body.eec-dark-mode .admin-dashboard .request-table-wrap {
  border-color: transparent !important;
}


/* ============================================================
   PROFILE / NAVBAR — NO HARD STROKES
   ============================================================ */

.admin-pro-navbar {
  border-bottom: none !important;
}

.admin-pro-profile,
.admin-pro-logo {
  border-color: transparent !important;
}

html.eec-dark-mode .admin-pro-navbar,
body.eec-dark-mode .admin-pro-navbar {
  border-bottom: none !important;
}

html.eec-dark-mode .admin-pro-profile,
body.eec-dark-mode .admin-pro-profile {
  border-color: transparent !important;
}


/* ============================================================
   SMOOTH PERFORMANCE
   ============================================================ */

.admin-dashboard .stat-card,
.admin-dashboard .requests-panel,
.admin-dashboard .stat-icon,
.admin-dashboard .request-table tbody tr {
  will-change: transform;
}


/* ============================================================
   REDUCED MOTION
   ============================================================ */

@media (prefers-reduced-motion: reduce) {

  .admin-dashboard .stat-card,
  .admin-dashboard .requests-panel {
    animation: none !important;
  }

  .admin-dashboard .stat-card,
  .admin-dashboard .request-table tbody tr {
    transition: none !important;
  }
}

