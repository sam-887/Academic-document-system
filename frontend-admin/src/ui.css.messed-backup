/* ============================================================
   ACADEMIC DOCUMENT SYSTEM — PROFESSIONAL UI SYSTEM
   UI ONLY — NO API / AUTH / WORKFLOW CHANGES
   ============================================================ */

:root {
  --ui-bg: #f6f8fc;
  --ui-surface: #ffffff;
  --ui-surface-soft: #f8fafc;
  --ui-border: #e5e7eb;
  --ui-text: #0f172a;
  --ui-muted: #64748b;
  --ui-primary: #2563eb;
  --ui-primary-dark: #1d4ed8;
  --ui-success: #16a34a;
  --ui-warning: #d97706;
  --ui-danger: #dc2626;
  --ui-radius: 16px;
  --ui-shadow: 0 8px 30px rgba(15,23,42,.06);
  --ui-shadow-hover: 0 14px 38px rgba(15,23,42,.10);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  background:
    radial-gradient(circle at 0% 0%, rgba(37,99,235,.045), transparent 30%),
    var(--ui-bg);
  color: var(--ui-text);
  font-family:
    Inter,
    ui-sans-serif,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;
  -webkit-font-smoothing: antialiased;
}

button,
input,
select,
textarea {
  font: inherit;
}

button {
  cursor: pointer;
}

a {
  color: inherit;
  text-decoration: none;
}

/* ---------- GLOBAL PAGE ---------- */

main,
.page,
.container {
  animation: uiPageIn .35s ease;
}

@keyframes uiPageIn {
  from {
    opacity: 0;
    transform: translateY(6px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ---------- HEADINGS ---------- */

h1 {
  font-size: clamp(1.65rem, 3vw, 2.2rem);
  line-height: 1.15;
  letter-spacing: -.035em;
  font-weight: 800;
}

h2 {
  font-size: 1.35rem;
  letter-spacing: -.025em;
  font-weight: 750;
}

h3 {
  font-weight: 700;
}

/* ---------- CARDS ---------- */

.bg-white {
  background: var(--ui-surface) !important;
}

.border {
  border-color: var(--ui-border) !important;
}

.rounded-2xl,
.rounded-xl {
  border-radius: var(--ui-radius) !important;
}

.shadow,
.shadow-sm,
.shadow-md {
  box-shadow: var(--ui-shadow) !important;
}

.bg-white.border {
  box-shadow: var(--ui-shadow);
  transition:
    transform .2s ease,
    box-shadow .2s ease,
    border-color .2s ease;
}

.bg-white.border:hover {
  box-shadow: var(--ui-shadow-hover);
}

/* ---------- BUTTONS ---------- */

button,
a[class*="bg-blue"],
a[class*="bg-indigo"] {
  transition:
    transform .15s ease,
    box-shadow .15s ease,
    background-color .15s ease;
}

button:hover,
a[class*="bg-blue"]:hover,
a[class*="bg-indigo"]:hover {
  transform: translateY(-1px);
}

button:active,
a[class*="bg-blue"]:active,
a[class*="bg-indigo"]:active {
  transform: translateY(0);
}

.bg-blue-600 {
  background-color: var(--ui-primary) !important;
}

.bg-blue-600:hover {
  background-color: var(--ui-primary-dark) !important;
}

/* ---------- FORM CONTROLS ---------- */

input,
select,
textarea {
  border: 1px solid var(--ui-border);
  background: #fff;
  color: var(--ui-text);
  border-radius: 10px;
  outline: none;
  transition:
    border-color .15s ease,
    box-shadow .15s ease;
}

input:focus,
select:focus,
textarea:focus {
  border-color: rgba(37,99,235,.65) !important;
  box-shadow: 0 0 0 4px rgba(37,99,235,.10);
}

textarea {
  resize: vertical;
}

/* ---------- TABLES ---------- */

table {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0;
  overflow: hidden;
}

thead {
  background: #f8fafc;
}

th {
  color: #475569;
  font-size: .72rem;
  text-transform: uppercase;
  letter-spacing: .07em;
  font-weight: 750;
}

th,
td {
  padding: 13px 16px;
  border-bottom: 1px solid var(--ui-border);
}

tbody tr {
  transition: background-color .15s ease;
}

tbody tr:hover {
  background: #f8fafc;
}

tbody tr:last-child td {
  border-bottom: 0;
}

/* ---------- STATUS BADGES ---------- */

.status-badge,
[class*="StatusBadge"] {
  border-radius: 999px;
}

/* ---------- FILTER AREA ---------- */

.ui-filter-bar {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8px;
  flex-wrap: wrap;
  margin-bottom: 18px;
}

.ui-filter-bar select {
  min-width: 145px;
  height: 38px;
  padding: 0 34px 0 12px;
  font-size: .82rem;
  font-weight: 600;
  background: white;
}

.ui-filter-label {
  font-size: .76rem;
  color: var(--ui-muted);
  font-weight: 700;
}

/* ---------- DASHBOARD STAT CARDS ---------- */

.grid > div[class*="border"],
.grid > a[class*="border"] {
  transition:
    transform .2s ease,
    box-shadow .2s ease;
}

.grid > div[class*="border"]:hover,
.grid > a[class*="border"]:hover {
  transform: translateY(-3px);
  box-shadow: var(--ui-shadow-hover);
}

/* ---------- NAVIGATION ---------- */

nav {
  border-color: var(--ui-border) !important;
}

nav a {
  transition:
    color .15s ease,
    background-color .15s ease;
}

nav a:hover {
  color: var(--ui-primary);
}

/* ---------- EMPTY STATES ---------- */

.text-slate-500:only-child,
.text-gray-500:only-child {
  color: var(--ui-muted);
}

/* ---------- CHAT ---------- */

.message-bubble {
  max-width: 75%;
  padding: 11px 14px;
  border-radius: 16px;
  box-shadow: 0 2px 8px rgba(15,23,42,.04);
}

/* ---------- DOCUMENT CARDS ---------- */

.document-card {
  background: white;
  border: 1px solid var(--ui-border);
  border-radius: var(--ui-radius);
  padding: 18px;
  box-shadow: var(--ui-shadow);
  transition: all .2s ease;
}

.document-card:hover {
  transform: translateY(-3px);
  box-shadow: var(--ui-shadow-hover);
}

/* ---------- REQUEST TIMELINE ---------- */

.request-timeline {
  position: relative;
}

.request-timeline::before {
  content: "";
  position: absolute;
  left: 15px;
  top: 8px;
  bottom: 8px;
  width: 2px;
  background: #e2e8f0;
}

/* ---------- SCROLLBAR ---------- */

::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}

::-webkit-scrollbar-track {
  background: transparent;
}

::-webkit-scrollbar-thumb {
  background: #cbd5e1;
  border-radius: 999px;
}

::-webkit-scrollbar-thumb:hover {
  background: #94a3b8;
}

/* ---------- MOBILE ---------- */

@media (max-width: 768px) {
  h1 {
    font-size: 1.55rem;
  }

  .ui-filter-bar {
    justify-content: flex-start;
  }

  .ui-filter-bar select {
    flex: 1;
    min-width: 135px;
  }

  table {
    min-width: 680px;
  }

  .message-bubble {
    max-width: 88%;
  }
}

/* ============================================================
   EEC ADMIN — STUDENT PORTAL VISUAL LANGUAGE
   UI ONLY — NO FUNCTIONAL CHANGES
   ============================================================ */

* {
  box-sizing: border-box;
}

body {
  font-family: Inter, ui-sans-serif, system-ui, -apple-system,
    BlinkMacSystemFont, "Segoe UI", sans-serif;
  background: #f6f8fc;
  color: #172033;
}

/* Same clean navbar language as Student Portal */
nav {
  background: rgba(255,255,255,.94) !important;
  border-bottom: 1px solid #e8ecf3 !important;
  box-shadow: 0 2px 12px rgba(15,23,42,.04) !important;
  backdrop-filter: blur(14px);
}

nav a {
  transition: all .2s ease !important;
}

nav a:hover {
  color: #2563eb !important;
}

/* Main */
main {
  min-height: calc(100vh - 70px);
}

/* Cards — same student portal feel */
main .bg-white {
  border-color: #e7ebf2 !important;
}

main .rounded-2xl {
  border-radius: 18px !important;
}

main .shadow-sm {
  box-shadow: 0 8px 30px rgba(15,23,42,.055) !important;
}

/* Subtle card hover only */
main .grid > div {
  transition: transform .2s ease, box-shadow .2s ease;
}

main .grid > div:hover {
  transform: translateY(-2px);
}

/* Inputs */
input,
select,
textarea {
  border-color: #dfe4ec !important;
  background: #fff !important;
  transition: border-color .2s ease, box-shadow .2s ease;
}

input:focus,
select:focus,
textarea:focus {
  border-color: #3b82f6 !important;
  box-shadow: 0 0 0 3px rgba(59,130,246,.12) !important;
  outline: none !important;
}

/* Tables */
table {
  border-collapse: separate !important;
  border-spacing: 0;
}

thead {
  background: #f8fafc !important;
}

th {
  color: #64748b !important;
}

tbody tr {
  transition: background .15s ease;
}

tbody tr:hover {
  background: #f8fbff !important;
}

/* Buttons */
button {
  transition: all .2s ease !important;
}

button:hover {
  transform: translateY(-1px);
}

/* ============================================================
   DARK MODE
   Same structure, same spacing, same cards.
   Only surfaces/colors change.
   ============================================================ */

body.eec-dark-mode {
  background: #0f172a !important;
  color: #e5e7eb !important;
}

body.eec-dark-mode main {
  background: #0f172a !important;
  color: #e5e7eb !important;
}

/* Navbar */
body.eec-dark-mode nav {
  background: rgba(15,23,42,.94) !important;
  border-color: #263449 !important;
  box-shadow: 0 2px 14px rgba(0,0,0,.18) !important;
}

/* Navigation */
body.eec-dark-mode nav a {
  color: #94a3b8 !important;
}

body.eec-dark-mode nav a:hover {
  color: #60a5fa !important;
  background: rgba(59,130,246,.08) !important;
}

body.eec-dark-mode nav a.active {
  color: #60a5fa !important;
  background: rgba(59,130,246,.12) !important;
}

/* Cards */
body.eec-dark-mode main .bg-white {
  background: #151d2d !important;
  color: #e5e7eb !important;
  border-color: #263449 !important;
  box-shadow: 0 8px 30px rgba(0,0,0,.16) !important;
}

/* Card hover */
body.eec-dark-mode main .grid > div:hover,
body.eec-dark-mode main .bg-white:hover {
  transform: translateY(-2px);
  background: #192337 !important;
  border-color: #334155 !important;
  box-shadow: 0 12px 34px rgba(0,0,0,.22) !important;
}

/* Headings */
body.eec-dark-mode main h1,
body.eec-dark-mode main h2,
body.eec-dark-mode main h3,
body.eec-dark-mode main h4 {
  color: #f8fafc !important;
}

/* Text */
body.eec-dark-mode main .text-slate-900,
body.eec-dark-mode main .text-slate-800,
body.eec-dark-mode main .text-gray-900,
body.eec-dark-mode main .text-gray-800 {
  color: #f8fafc !important;
}

body.eec-dark-mode main .text-slate-700,
body.eec-dark-mode main .text-gray-700 {
  color: #cbd5e1 !important;
}

body.eec-dark-mode main .text-slate-600,
body.eec-dark-mode main .text-gray-600 {
  color: #94a3b8 !important;
}

body.eec-dark-mode main .text-slate-500,
body.eec-dark-mode main .text-gray-500 {
  color: #64748b !important;
}

/* Soft backgrounds */
body.eec-dark-mode main .bg-slate-50,
body.eec-dark-mode main .bg-gray-50 {
  background: #111827 !important;
}

body.eec-dark-mode main .bg-slate-100,
body.eec-dark-mode main .bg-gray-100 {
  background: #1e293b !important;
}

/* Inputs */
body.eec-dark-mode main input,
body.eec-dark-mode main select,
body.eec-dark-mode main textarea {
  background: #111827 !important;
  color: #f8fafc !important;
  border-color: #334155 !important;
}

body.eec-dark-mode main input::placeholder,
body.eec-dark-mode main textarea::placeholder {
  color: #64748b !important;
}

/* Tables */
body.eec-dark-mode main table {
  background: #151d2d !important;
  color: #e5e7eb !important;
}

body.eec-dark-mode main thead {
  background: #111827 !important;
}

body.eec-dark-mode main th {
  color: #94a3b8 !important;
}

body.eec-dark-mode main td {
  background: #151d2d !important;
  color: #cbd5e1 !important;
  border-color: #263449 !important;
}

body.eec-dark-mode main tbody tr:hover td {
  background: #192337 !important;
}

/* Preserve status colors */
body.eec-dark-mode main .bg-green-100 {
  background: rgba(34,197,94,.12) !important;
  color: #4ade80 !important;
}

body.eec-dark-mode main .bg-amber-100 {
  background: rgba(245,158,11,.12) !important;
  color: #fbbf24 !important;
}

body.eec-dark-mode main .bg-red-100 {
  background: rgba(239,68,68,.12) !important;
  color: #f87171 !important;
}

body.eec-dark-mode main .bg-blue-100 {
  background: rgba(59,130,246,.12) !important;
  color: #60a5fa !important;
}

/* IMPORTANT:
   Don't let old aggressive global hover rules distort the dashboard.
*/
body.eec-dark-mode main .grid > div:hover {
  transform: translateY(-2px) !important;
}

body.eec-dark-mode main button:hover {
  transform: translateY(-1px) !important;
}

