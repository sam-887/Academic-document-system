/* =========================================================
   EEC ADMIN - PREMIUM SMOOTH UI
   ========================================================= */

:root {
  --admin-red: #c91f3b;
  --admin-red-dark: #8f1230;
  --admin-pink: #f8dce4;
  --admin-purple: #35152f;
  --admin-bg: #f7eef2;
}

/* Page background */
body {
  background:
    radial-gradient(
      circle at 10% 10%,
      rgba(201, 31, 59, 0.10),
      transparent 32%
    ),
    radial-gradient(
      circle at 90% 20%,
      rgba(110, 35, 95, 0.10),
      transparent 30%
    ),
    linear-gradient(
      135deg,
      #faf5f7 0%,
      #f5edf1 45%,
      #f9f4f6 100%
    );
}

/* =========================================================
   PAGE ENTRANCE
   ========================================================= */

#root {
  animation: adminPageEnter 0.8s cubic-bezier(.16,1,.3,1) both;
}

@keyframes adminPageEnter {
  from {
    opacity: 0;
    transform: translateY(18px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* =========================================================
   REAL CARDS
   ========================================================= */

[class*="rounded-2xl"][class*="shadow"],
[class*="rounded-xl"][class*="shadow"] {
  position: relative !important;

  animation:
    adminCardIn 0.9s cubic-bezier(.16,1,.3,1) both !important;

  transition:
    transform 0.45s cubic-bezier(.16,1,.3,1),
    box-shadow 0.45s cubic-bezier(.16,1,.3,1),
    border-color 0.3s ease !important;

  will-change: transform;
}

/* Stagger */
[class*="rounded-2xl"][class*="shadow"]:nth-child(1) {
  animation-delay: 0.05s !important;
}

[class*="rounded-2xl"][class*="shadow"]:nth-child(2) {
  animation-delay: 0.12s !important;
}

[class*="rounded-2xl"][class*="shadow"]:nth-child(3) {
  animation-delay: 0.19s !important;
}

[class*="rounded-2xl"][class*="shadow"]:nth-child(4) {
  animation-delay: 0.26s !important;
}

[class*="rounded-2xl"][class*="shadow"]:nth-child(5) {
  animation-delay: 0.33s !important;
}

[class*="rounded-2xl"][class*="shadow"]:nth-child(6) {
  animation-delay: 0.40s !important;
}

/* Entrance */
@keyframes adminCardIn {
  0% {
    opacity: 0;
    transform: translateY(45px) scale(.92) !important;
    filter: blur(7px);
  }

  55% {
    opacity: 1;
    transform: translateY(-7px) scale(1.02) !important;
    filter: blur(0);
  }

  75% {
    transform: translateY(3px) scale(.995) !important;
  }

  100% {
    opacity: 1;
    transform: translateY(0) scale(1) !important;
    filter: blur(0);
  }
}

/* =========================================================
   HOVER
   ========================================================= */

[class*="rounded-2xl"][class*="shadow"]:hover,
[class*="rounded-xl"][class*="shadow"]:hover {
  transform: translateY(-9px) scale(1.015) !important;

  box-shadow:
    0 28px 65px rgba(72, 18, 55, .16),
    0 10px 25px rgba(72, 18, 55, .08) !important;
}

/* =========================================================
   CARD LIGHT
   ========================================================= */

[class*="rounded-2xl"][class*="shadow"]::after,
[class*="rounded-xl"][class*="shadow"]::after {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  pointer-events: none;

  background:
    linear-gradient(
      120deg,
      rgba(255,255,255,.38),
      transparent 35%,
      transparent 65%,
      rgba(255,255,255,.16)
    );

  opacity: 0;
  transition: opacity .45s ease;
}

[class*="rounded-2xl"][class*="shadow"]:hover::after,
[class*="rounded-xl"][class*="shadow"]:hover::after {
  opacity: 1;
}

/* =========================================================
   STAT NUMBERS
   ========================================================= */

[class*="text-3xl"],
[class*="text-4xl"] {
  animation: adminNumber .8s cubic-bezier(.16,1,.3,1) both;
}

@keyframes adminNumber {
  from {
    opacity: 0;
    transform: translateY(16px) scale(.75);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

/* =========================================================
   BUTTONS
   ========================================================= */

button {
  transition:
    transform .3s cubic-bezier(.16,1,.3,1),
    box-shadow .3s ease,
    background .3s ease !important;
}

button:hover {
  transform: translateY(-3px) !important;
  box-shadow: 0 12px 28px rgba(60,20,50,.15) !important;
}

button:active {
  transform: scale(.96) !important;
}

/* =========================================================
   LINKS / NAVIGATION
   ========================================================= */

a {
  transition:
    color .25s ease,
    transform .25s ease,
    opacity .25s ease !important;
}

nav a:hover {
  transform: translateY(-2px);
}

/* =========================================================
   SMOOTH SCROLL
   ========================================================= */

html {
  scroll-behavior: smooth;
}

/* =========================================================
   ACCESSIBILITY
   ========================================================= */

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.001ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.001ms !important;
  }
}

/* =========================================================
   EEC ADMIN - GLASSMORPHISM OVERRIDE
   Keeps existing animations
   ========================================================= */

:root {
  --glass-white: rgba(255, 255, 255, 0.62);
  --glass-white-soft: rgba(255, 255, 255, 0.42);
  --glass-border: rgba(255, 255, 255, 0.72);
  --glass-shadow: rgba(48, 20, 42, 0.10);
}

/* ---------- GLOBAL BACKGROUND ---------- */

html,
body,
#root {
  min-height: 100%;
}

body {
  background:
    radial-gradient(
      900px circle at 8% 8%,
      rgba(255, 110, 135, 0.13),
      transparent 60%
    ),
    radial-gradient(
      850px circle at 92% 15%,
      rgba(130, 85, 180, 0.11),
      transparent 60%
    ),
    radial-gradient(
      900px circle at 50% 100%,
      rgba(245, 150, 175, 0.10),
      transparent 60%
    ),
    #f4f0f3 !important;

  background-attachment: fixed !important;
}

/* ---------- REMOVE PATCHY SECTION BACKGROUNDS ---------- */

main,
main > div,
main section {
  background: transparent !important;
}

/* ---------- NAVBAR GLASS ---------- */

nav,
header {
  background: rgba(255, 255, 255, 0.72) !important;
  backdrop-filter: blur(22px) saturate(150%) !important;
  -webkit-backdrop-filter: blur(22px) saturate(150%) !important;

  border-bottom: 1px solid rgba(255, 255, 255, 0.75) !important;

  box-shadow:
    0 8px 30px rgba(50, 20, 45, 0.06) !important;

  position: relative;
  z-index: 20;
}

/* ---------- ALL MAJOR CARDS ---------- */

[class*="rounded-2xl"][class*="shadow"],
[class*="rounded-xl"][class*="shadow"] {

  background:
    linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.78),
      rgba(255, 255, 255, 0.52)
    ) !important;

  backdrop-filter: blur(22px) saturate(145%) !important;
  -webkit-backdrop-filter: blur(22px) saturate(145%) !important;

  border:
    1px solid rgba(255, 255, 255, 0.78) !important;

  box-shadow:
    0 15px 45px rgba(55, 25, 50, 0.08),
    inset 0 1px 0 rgba(255, 255, 255, 0.85) !important;

  overflow: hidden;
}

/* ---------- GLASS HOVER ---------- */

[class*="rounded-2xl"][class*="shadow"]:hover,
[class*="rounded-xl"][class*="shadow"]:hover {

  background:
    linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.88),
      rgba(255, 255, 255, 0.62)
    ) !important;

  box-shadow:
    0 28px 65px rgba(55, 25, 50, 0.13),
    inset 0 1px 0 rgba(255, 255, 255, 0.95) !important;
}

/* ---------- GLASS INNER HIGHLIGHT ---------- */

[class*="rounded-2xl"][class*="shadow"]::after,
[class*="rounded-xl"][class*="shadow"]::after {

  content: "";
  position: absolute;
  inset: 0;

  background:
    linear-gradient(
      125deg,
      rgba(255,255,255,0.34) 0%,
      transparent 28%,
      transparent 72%,
      rgba(255,255,255,0.12) 100%
    );

  pointer-events: none;
  border-radius: inherit;
  opacity: 0.7;
}

/* ---------- SMALL STAT BLOCKS ---------- */

[class*="bg-red-"],
[class*="bg-green-"],
[class*="bg-yellow-"],
[class*="bg-purple-"],
[class*="bg-blue-"] {

  backdrop-filter: blur(15px) !important;
  -webkit-backdrop-filter: blur(15px) !important;
}

/* ---------- INPUTS ---------- */

input,
select,
textarea {

  background: rgba(255, 255, 255, 0.58) !important;

  backdrop-filter: blur(14px) !important;
  -webkit-backdrop-filter: blur(14px) !important;

  border-color: rgba(255, 255, 255, 0.75) !important;

  box-shadow:
    inset 0 1px 2px rgba(40, 20, 40, 0.025),
    0 5px 20px rgba(50, 20, 45, 0.035) !important;
}

input:focus,
select:focus,
textarea:focus {

  background: rgba(255, 255, 255, 0.76) !important;

  box-shadow:
    0 0 0 3px rgba(201, 31, 59, 0.08),
    0 10px 30px rgba(50, 20, 45, 0.07) !important;
}

/* ---------- BUTTON GLASS ---------- */

button {

  backdrop-filter: blur(12px) !important;
  -webkit-backdrop-filter: blur(12px) !important;

  border: 1px solid rgba(255,255,255,0.25) !important;
}

/* ---------- RED ADMIN ACCENT ---------- */

button.bg-red-600,
button[class*="bg-red-"] {

  background:
    linear-gradient(
      135deg,
      #d92b49,
      #b7193c
    ) !important;

  box-shadow:
    0 10px 25px rgba(185, 25, 60, 0.20) !important;
}

button.bg-red-600:hover,
button[class*="bg-red-"]:hover {

  box-shadow:
    0 16px 35px rgba(185, 25, 60, 0.28) !important;
}

/* ---------- STATUS COLORS: SOFT GLASS ---------- */

[class*="bg-green-100"] {
  background: rgba(34, 197, 94, 0.13) !important;
}

[class*="bg-red-100"] {
  background: rgba(239, 68, 68, 0.12) !important;
}

[class*="bg-yellow-100"] {
  background: rgba(234, 179, 8, 0.14) !important;
}

[class*="bg-blue-100"] {
  background: rgba(59, 130, 246, 0.12) !important;
}

[class*="bg-purple-100"] {
  background: rgba(168, 85, 247, 0.12) !important;
}

/* ---------- SMOOTH PAGE ---------- */

main {
  position: relative;
  z-index: 1;
}

/* ---------- SCROLLBAR ---------- */

::-webkit-scrollbar {
  width: 8px;
}

::-webkit-scrollbar-track {
  background: transparent;
}

::-webkit-scrollbar-thumb {
  background: rgba(80, 35, 65, 0.20);
  border-radius: 20px;
}

::-webkit-scrollbar-thumb:hover {
  background: rgba(80, 35, 65, 0.32);
}

/* ---------- KEEP MOTION ---------- */

@media (prefers-reduced-motion: no-preference) {

  [class*="rounded-2xl"][class*="shadow"],
  [class*="rounded-xl"][class*="shadow"] {
    transform-style: preserve-3d;
  }

}

/* ---------- MOBILE ---------- */

@media (max-width: 768px) {

  body {
    background:
      radial-gradient(
        500px circle at 50% 0%,
        rgba(255, 110, 135, 0.12),
        transparent 70%
      ),
      #f4f0f3 !important;
  }

  [class*="rounded-2xl"][class*="shadow"],
  [class*="rounded-xl"][class*="shadow"] {
    backdrop-filter: blur(16px) !important;
    -webkit-backdrop-filter: blur(16px) !important;
  }

}


/* =========================================================
   EEC ADMIN - GLASS UI VISUAL FIX
   ========================================================= */

:root {
  --admin-bg: #f1f3f8;
  --admin-surface: rgba(255,255,255,.84);
  --admin-text: #172033;
  --admin-muted: #64748b;
  --admin-red: #d61f45;
}

/* Admin background */

html,
body,
#root {
  min-height: 100%;
}

body {
  background:
    radial-gradient(circle at 5% 10%, rgba(214,31,69,.11), transparent 27%),
    radial-gradient(circle at 95% 10%, rgba(99,102,241,.09), transparent 28%),
    radial-gradient(circle at 50% 100%, rgba(214,31,69,.06), transparent 30%),
    var(--admin-bg) !important;

  color: var(--admin-text);
}

/* Header */

nav,
header {
  position: relative;
  z-index: 1000;

  background: rgba(255,255,255,.90) !important;

  backdrop-filter: blur(22px);
  -webkit-backdrop-filter: blur(22px);

  border-bottom: 1px solid rgba(15,23,42,.08) !important;

  box-shadow:
    0 8px 30px rgba(15,23,42,.065) !important;
}

/* EEC Admin Portal */

nav a:first-child,
header a:first-child {
  color: #9f1239 !important;
  opacity: 1 !important;
  visibility: visible !important;
  font-weight: 800 !important;
}

/* Navigation */

nav a,
header a,
nav button,
header button {
  color: #475569 !important;
  opacity: 1 !important;
}

nav a:hover,
header a:hover {
  color: #be123c !important;
}

nav a[class*="active"],
header a[class*="active"],
nav a[aria-current="page"],
header a[aria-current="page"] {
  color: #be123c !important;
}

/* Cards */

.bg-white,
[class*="bg-white"] {
  background: rgba(255,255,255,.84) !important;

  border-color: rgba(15,23,42,.08) !important;

  box-shadow:
    0 14px 38px rgba(15,23,42,.07),
    inset 0 1px 0 rgba(255,255,255,.95);

  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

.bg-white:hover,
[class*="bg-white"]:hover {
  transform: translateY(-3px);

  box-shadow:
    0 22px 55px rgba(15,23,42,.11),
    inset 0 1px 0 rgba(255,255,255,1);

  transition:
    transform .35s cubic-bezier(.2,.8,.2,1),
    box-shadow .35s ease;
}

/* Text */

.text-slate-800,
.text-slate-900 {
  color: #172033 !important;
}

.text-slate-700 {
  color: #334155 !important;
}

.text-slate-600,
.text-slate-500 {
  color: #64748b !important;
}

/* Admin red buttons */

.bg-red-600 {
  background: linear-gradient(
    135deg,
    #e11d48,
    #be123c
  ) !important;

  box-shadow:
    0 9px 25px rgba(225,29,72,.23);
}

.bg-red-600:hover {
  background: linear-gradient(
    135deg,
    #be123c,
    #9f1239
  ) !important;

  box-shadow:
    0 14px 32px rgba(225,29,72,.30);
}

/* Settings */

.absolute {
  z-index: 2000;
}

[class*="absolute"][class*="right-"] {
  background: rgba(255,255,255,.95) !important;

  backdrop-filter: blur(26px);
  -webkit-backdrop-filter: blur(26px);

  border: 1px solid rgba(15,23,42,.09) !important;

  box-shadow:
    0 25px 70px rgba(15,23,42,.16) !important;

  border-radius: 18px !important;
}

/* Inputs */

input,
select,
textarea {
  background: rgba(255,255,255,.80) !important;

  border-color: rgba(15,23,42,.10) !important;

  color: #172033 !important;
}

input:focus,
select:focus,
textarea:focus {
  outline: none !important;

  border-color: rgba(190,18,60,.40) !important;

  box-shadow:
    0 0 0 4px rgba(190,18,60,.10) !important;
}

/* Analytics */

.grid > div {
  transition:
    transform .38s cubic-bezier(.2,.8,.2,1),
    box-shadow .38s ease;
}

.grid > div:hover {
  transform: translateY(-4px);
}

/* Entrance */

@keyframes adminFadeUp {
  from {
    opacity: 0;
    transform: translateY(14px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

main > div {
  animation:
    adminFadeUp .55s cubic-bezier(.2,.8,.2,1) both;
}

/* Buttons */

button {
  transition:
    transform .25s cubic-bezier(.2,.8,.2,1),
    box-shadow .25s ease;
}

button:hover {
  transform: translateY(-1px);
}

button:active {
  transform: scale(.98);
}

/* Scrollbar */

::-webkit-scrollbar {
  width: 8px;
}

::-webkit-scrollbar-track {
  background: transparent;
}

::-webkit-scrollbar-thumb {
  background: rgba(71,85,105,.25);
  border-radius: 20px;
}

::-webkit-scrollbar-thumb:hover {
  background: rgba(190,18,60,.45);
}

@media (max-width: 900px) {

  nav,
  header {
    min-height: 64px;
  }

  nav a,
  header a {
    font-size: 14px;
  }

}

/* ===== EEC ADMIN LIGHT GLASS THEME OVERRIDE ===== */

:root {
  --eec-red: #b3133f;
  --eec-red-soft: #d62955;
  --eec-bg: #f5f7fb;
  --eec-text: #172033;
  --eec-muted: #68758a;
  --eec-card: rgba(255,255,255,.82);
  --eec-border: rgba(255,255,255,.9);
}

/* Prevent dark global backgrounds */
html,
body,
#root {
  min-height: 100%;
  background:
    radial-gradient(circle at 8% 8%, rgba(214,41,85,.08), transparent 28%),
    radial-gradient(circle at 92% 12%, rgba(79,116,255,.09), transparent 30%),
    linear-gradient(135deg, #f8f9fc 0%, #f2f5fa 50%, #f8f7fa 100%) !important;
  color: var(--eec-text) !important;
}

/* Main application surface */
body {
  margin: 0;
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  overflow-x: hidden;
}

/* Keep content readable */
main,
section,
.app,
.page,
[class*="page"],
[class*="content"] {
  color: var(--eec-text);
}

/* Glass header/navbar */
nav,
header,
[class*="navbar"],
[class*="Navbar"],
[class*="header"],
[class*="Header"] {
  background: rgba(255,255,255,.78) !important;
  backdrop-filter: blur(22px) saturate(150%) !important;
  -webkit-backdrop-filter: blur(22px) saturate(150%) !important;
  border-bottom: 1px solid rgba(255,255,255,.95) !important;
  box-shadow: 0 8px 30px rgba(31,41,55,.06) !important;
}

/* Navbar links */
nav a,
header a,
nav button,
header button {
  color: #596579 !important;
  transition:
    color .25s ease,
    background .3s ease,
    transform .3s cubic-bezier(.22,1,.36,1),
    box-shadow .3s ease !important;
}

nav a:hover,
header a:hover,
nav button:hover,
header button:hover {
  color: var(--eec-red) !important;
  transform: translateY(-2px);
}

/* Active navigation */
nav a.active,
header a.active,
nav [aria-current="page"],
header [aria-current="page"] {
  color: var(--eec-red) !important;
  background: rgba(255,255,255,.92) !important;
  box-shadow:
    0 8px 22px rgba(179,19,63,.10),
    inset 0 0 0 1px rgba(179,19,63,.05) !important;
}

/* Cards / panels */
.card,
[class*="card"],
[class*="Card"],
[class*="panel"],
[class*="Panel"] {
  background: var(--eec-card) !important;
  border: 1px solid var(--eec-border) !important;
  box-shadow:
    0 12px 35px rgba(31,41,55,.07),
    0 2px 8px rgba(31,41,55,.035) !important;
  backdrop-filter: blur(18px) saturate(140%) !important;
  -webkit-backdrop-filter: blur(18px) saturate(140%) !important;
  transition:
    transform .35s cubic-bezier(.22,1,.36,1),
    box-shadow .35s ease,
    border-color .35s ease !important;
}

/* Smooth card animation */
.card:hover,
[class*="card"]:hover,
[class*="Card"]:hover,
[class*="panel"]:hover,
[class*="Panel"]:hover {
  transform: translateY(-4px);
  box-shadow:
    0 20px 45px rgba(31,41,55,.10),
    0 5px 15px rgba(179,19,63,.05) !important;
}

/* Buttons */
button,
[role="button"] {
  transition:
    transform .25s cubic-bezier(.22,1,.36,1),
    box-shadow .25s ease,
    background .25s ease !important;
}

button:hover,
[role="button"]:hover {
  transform: translateY(-2px);
}

/* Primary red buttons */
button[class*="bg-red"],
button[class*="bg-rose"],
button[class*="bg-pink"],
.bg-red-600,
.bg-rose-600,
.bg-pink-600 {
  background: linear-gradient(135deg, #b3133f, #d62955) !important;
  box-shadow: 0 8px 22px rgba(179,19,63,.18) !important;
}

/* Inputs */
input,
select,
textarea {
  background: rgba(255,255,255,.82) !important;
  color: var(--eec-text) !important;
  border-color: rgba(148,163,184,.25) !important;
  backdrop-filter: blur(12px);
  transition:
    border-color .25s ease,
    box-shadow .25s ease,
    background .25s ease !important;
}

input:focus,
select:focus,
textarea:focus {
  background: rgba(255,255,255,.96) !important;
  border-color: rgba(179,19,63,.35) !important;
  box-shadow: 0 0 0 4px rgba(179,19,63,.08) !important;
  outline: none !important;
}

/* Dropdown/profile/settings glass */
[class*="dropdown"],
[class*="Dropdown"],
[class*="menu"],
[class*="Menu"] {
  background: rgba(255,255,255,.92) !important;
  backdrop-filter: blur(22px) saturate(150%) !important;
  -webkit-backdrop-filter: blur(22px) saturate(150%) !important;
  border: 1px solid rgba(255,255,255,.95) !important;
  box-shadow: 0 18px 50px rgba(31,41,55,.12) !important;
}

/* Red accent text */
.text-red-600,
.text-rose-600,
.text-pink-600 {
  color: var(--eec-red) !important;
}

/* Smooth page appearance */
main,
.page,
.app {
  animation: eecPageIn .55s cubic-bezier(.22,1,.36,1);
}

@keyframes eecPageIn {
  from {
    opacity: 0;
    transform: translateY(8px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Prevent accidental dark overlays */
.bg-gray-900,
.bg-slate-900,
.bg-zinc-900,
.bg-neutral-900 {
  background-color: rgba(255,255,255,.82) !important;
}

/* Better readable muted text */
.text-gray-500,
.text-gray-600,
.text-slate-500,
.text-slate-600,
.text-zinc-500,
.text-zinc-600 {
  color: var(--eec-muted) !important;
}
